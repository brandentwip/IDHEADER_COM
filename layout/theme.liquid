    <script>

  document.addEventListener('DOMContentLoaded', function () {
    // Initially hide elements
    document.querySelector('.template-index .bestsellers').style.display = 'none';
    document.querySelector('body .under-2599').style.display = 'none';
    document.querySelector('.offers').style.display = 'none';

    // Add event listeners for button clicks
    document.querySelector('.btn-1').addEventListener('click', function () {
        deactivateAll();
        this.classList.add('actived');
        document.querySelector('body .under-2599').style.display = 'block';
        hideElements(['.bestsellers', '.new-arrivals', '.offers']);
    });

    document.querySelector('.btn-2').addEventListener('click', function () {
        deactivateAll();
        this.classList.add('actived');
        document.querySelector('body .bestsellers').style.display = 'block';
        hideElements(['.under-2599', '.new-arrivals', '.offers']);
    });

    document.querySelector('.btn-3').addEventListener('click', function () {
        deactivateAll();
        this.classList.add('actived');
        document.querySelector('body .new-arrivals').style.display = 'block';
        hideElements(['.under-2599', '.bestsellers', '.offers']);
    });

    document.querySelector('.btn-4').addEventListener('click', function () {
        deactivateAll();
        this.classList.add('actived');
        document.querySelector('body .offers').style.display = 'block';
        hideElements(['.under-2599', '.bestsellers', '.new-arrivals']);
    });

    // Helper function to deactivate all buttons
    function deactivateAll() {
        document.querySelectorAll('.btn-1, .btn-2, .btn-3, .btn-4').forEach(function (btn) {
            btn.classList.remove('actived');
        });
    }

    // Helper function to hide multiple elements
    function hideElements(selectors) {
        selectors.forEach(function (selector) {
            const element = document.querySelector(selector);
            if (element) {
                element.style.display = 'none';
            }
        });
    }
});

      
    </script>


