<style>
  /* =========================================================
     DROPINBLOG PRODUCT CAROUSEL
  ========================================================= */

  .dib-product-carousel {
    width: 100%;
    margin: 40px 0;
    position: relative;
    box-sizing: border-box;
  }

  .dib-product-carousel__heading {
    margin: 0 0 20px;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 600;
  }

  .dib-product-carousel__wrapper {
    position: relative;
  }

  .dib-product-carousel__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 2px 10px;
    scroll-snap-type: x mandatory;
  }

  .dib-product-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .dib-product-card {
    flex: 0 0 calc(25% - 14px);
    min-width: 220px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

