<script>
(function () {

  /* =========================================================
     IDCULT × DROPINBLOG PRODUCT CAROUSEL
  ========================================================= */

  function initDibProductCarousels() {

    var carousels = document.querySelectorAll(
      '.dib-product-carousel:not([data-dib-initialized])'
    );

    carousels.forEach(function (carousel) {

      carousel.setAttribute(
        'data-dib-initialized',
        'true'
      );

      var productString =
        carousel.getAttribute('data-products');

      if (!productString) {
        carousel.innerHTML =
          '<div class="dib-product-carousel__empty">' +
          'No products selected.' +
          '</div>';
        return;
      }

      /*
       * Product URLs
       */

      var productUrls = productString
        .split(',')
        .map(function (url) {
          return url.trim();
        })
        .filter(Boolean);

      var title =
        carousel.getAttribute('data-title') ||
        'Shop The Article';

      /*
       * Build heading
       */

      carousel.innerHTML = '';

      var headingWrap =
        document.createElement('div');

      headingWrap.className =
        'dib-product-carousel__heading-wrap';

      var headingContent =
        document.createElement('div');

      var eyebrow =
        document.createElement('p');

      eyebrow.className =
        'dib-product-carousel__eyebrow';

      eyebrow.textContent =
        'Selected for you';

      var heading =
        document.createElement('h3');

      heading.className =
        'dib-product-carousel__heading';

      heading.textContent = title;

      headingContent.appendChild(eyebrow);
      headingContent.appendChild(heading);

      /*
       * Counter
       */

      var counter =
        document.createElement('div');

      counter.className =
        'dib-product-carousel__counter';

      counter.textContent =
        productUrls.length + ' PRODUCTS';

      /*
       * Navigation
       */

      var nav =
        document.createElement('div');

      nav.className =
        'dib-product-carousel__nav';

      var prevButton =
        document.createElement('button');

      prevButton.type = 'button';

      prevButton.className =
        'dib-product-carousel__button';

      prevButton.setAttribute(
        'aria-label',
        'Previous products'
      );

      prevButton.innerHTML =
        '<span>‹</span>';

      var nextButton =
        document.createElement('button');

      nextButton.type = 'button';

      nextButton.className =
        'dib-product-carousel__button';

      nextButton.setAttribute(
        'aria-label',
        'Next products'
      );

      nextButton.innerHTML =
        '<span>›</span>';

      nav.appendChild(prevButton);
      nav.appendChild(nextButton);

      headingWrap.appendChild(
        headingContent
      );

      headingWrap.appendChild(
        counter
      );

      headingWrap.appendChild(
        nav
      );

      carousel.appendChild(
        headingWrap
      );

      /*
       * Track
       */

      var wrapper =
        document.createElement('div');

      wrapper.className =
        'dib-product-carousel__wrapper';

      var track =
        document.createElement('div');

      track.className =
        'dib-product-carousel__track';

      wrapper.appendChild(track);

      carousel.appendChild(wrapper);

      /*
       * Loading
       */

      var loading =
        document.createElement('div');

      loading.className =
        'dib-product-carousel__loading';

      loading.textContent =
        'Loading products...';

      track.appendChild(loading);

      /*
       * Extract handles
       */

      var handles = productUrls
        .map(function (url) {

          try {

            var parsedUrl =
              new URL(url);

            var parts =
              parsedUrl.pathname
                .split('/')
                .filter(Boolean);

            var productsIndex =
              parts.indexOf('products');

            if (
              productsIndex !== -1 &&
              parts[productsIndex + 1]
            ) {

              return parts[
                productsIndex + 1
              ];

            }

          } catch (error) {

            console.warn(
              'Invalid product URL:',
              url
            );

          }

          return null;

        })
        .filter(Boolean);

      /*
       * Fetch Shopify products
       */

      var requests =
        handles.map(function (handle) {

          return fetch(
            '/products/' +
            encodeURIComponent(handle) +
            '.js'
          )
          .then(function (response) {

            if (!response.ok) {
              throw new Error(
                'Product not found: ' +
                handle
              );
            }

            return response.json();

          })
          .catch(function (error) {

            console.warn(
              'DropInBlog product:',
              error.message
            );

            return null;

          });

        });

      /*
       * Render products
       */

      Promise.all(requests)
        .then(function (products) {

          track.innerHTML = '';

          var validProducts =
            products.filter(function (product) {
              return product !== null;
            });

          if (!validProducts.length) {

            track.innerHTML =
              '<div class="dib-product-carousel__empty">' +
              'No products found.' +
              '</div>';

            return;

          }

          validProducts.forEach(
            function (product) {

              var card =
                document.createElement('article');

              card.className =
                'dib-product-card';

              /*
               * Product URL
               */

              var productUrl =
                product.url;

              /*
               * Image
               */

              var imageLink =
                document.createElement('a');

              imageLink.className =
                'dib-product-card__image';

              imageLink.href =
                productUrl;

              if (product.featured_image) {

                var image =
                  document.createElement('img');

                image.src =
                  product.featured_image;

                image.alt =
                  product.title || '';

                image.loading =
                  'lazy';

                imageLink.appendChild(
                  image
                );

              }

              /*
               * Information
               */

              var info =
                document.createElement('div');

              info.className =
                'dib-product-card__info';

              /*
               * Title
               */

              var titleElement =
                document.createElement('h4');

              titleElement.className =
                'dib-product-card__title';

              var titleLink =
                document.createElement('a');

              titleLink.href =
                productUrl;

              titleLink.textContent =
                product.title;

              titleElement.appendChild(
                titleLink
              );

              /*
               * Price
               */

              var price =
                document.createElement('div');

              price.className =
                'dib-product-card__price';

              price.textContent =
                formatMoney(
                  product.price
                );

              /*
               * CTA
               */

              var button =
                document.createElement('a');

              button.className =
                'dib-product-card__button';

              button.href =
                productUrl;

              button.textContent =
                'View product';

              /*
               * Assemble
               */

              info.appendChild(
                titleElement
              );

              info.appendChild(
                price
              );

              info.appendChild(
                button
              );

              card.appendChild(
                imageLink
              );

              card.appendChild(
                info
              );

              track.appendChild(
                card
              );

            }
          );

          /*
           * Navigation state
           */

          function updateButtons() {

            var maxScroll =
              track.scrollWidth -
              track.clientWidth;

            prevButton.disabled =
              track.scrollLeft <= 5;

            nextButton.disabled =
              track.scrollLeft >=
              maxScroll - 5;

          }

          updateButtons();

          track.addEventListener(
            'scroll',
            updateButtons,
            { passive: true }
          );

          /*
           * Navigation
           */

          prevButton.addEventListener(
            'click',
            function () {

              track.scrollBy({
                left:
                  -track.clientWidth * .82,
                behavior: 'smooth'
              });

            }
          );

          nextButton.addEventListener(
            'click',
            function () {

              track.scrollBy({
                left:
                  track.clientWidth * .82,
                behavior: 'smooth'
              });

            }
          );

          window.addEventListener(
            'resize',
            updateButtons
          );

        });

    });

  }

  /*
   * Currency
   */

  function formatMoney(cents) {

    return new Intl.NumberFormat(
      document.documentElement.lang ||
      'en-IN',
      {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }
    ).format(cents / 100);

  }

  /*
   * Start
   */

  function start() {
    initDibProductCarousels();
  }

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      start
    );

  } else {

    start();

  }

  /*
   * DropInBlog dynamic content observer
   */

  var observer =
    new MutationObserver(
      function () {
        initDibProductCarousels();
      }
    );

  observer.observe(
    document.documentElement,
    {
      childList: true,
      subtree: true
    }
  );

})();
</script>
