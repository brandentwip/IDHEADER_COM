  function populateCities() {
    const stateDropdown = document.getElementById("state");
    const cityDropdown = document.getElementById("dropdown");
    const selectedState = stateDropdown.value;

    cityDropdown.innerHTML = '';
    const defaultOption = document.createElement("option");
    defaultOption.text = "Select City";
    defaultOption.value = "";
    defaultOption.disabled = true;
    defaultOption.selected = true;
    cityDropdown.appendChild(defaultOption);

    if (selectedState && stateCities[selectedState]) {
      const cities = stateCities[selectedState];
      cities.forEach((city) => {
        const option = document.createElement("option");
        const lowercasecity = city.toLowerCase();
        option.text = city;
        option.value = lowercasecity;
        cityDropdown.appendChild(option);
      });
    }

    cityDropdown.addEventListener("change", function () {
      if (cityDropdown.value !== "") {
        defaultOption.style.display = "none";
      } else {
        defaultOption.style.display = "block";
      }
    });
  }

  function showSelectedDiv() {
    const urlParams = new URLSearchParams(window.location.search);
    const showValue = urlParams.get("store");

    const dropdown = document.getElementById("dropdown");
    dropdown.value = showValue;

    const divs = document.querySelectorAll(".hidden");
    const defaultStoreDiv = document.querySelector(".default-store");

    divs.forEach(function (div) {
      div.style.display = "none";
    });

    if (showValue) {
      const selectedDiv = document.getElementById(showValue);
      if (selectedDiv) {
        selectedDiv.style.display = "block";
      }
      if (defaultStoreDiv) {
        defaultStoreDiv.style.display = "none";
      }
    } else {
      divs.forEach(function (div) {
        div.style.display = "none";
      });
      if (defaultStoreDiv) {
        defaultStoreDiv.style.display = "block";
      }
    }
  }

  showSelectedDiv();

  const dropdown = document.getElementById("dropdown");
  dropdown.addEventListener("change", function () {
    const selectedValue = dropdown.value;
    const currentURL = new URL(window.location.href);
    currentURL.searchParams.set("store", selectedValue);
    window.history.pushState({}, "", currentURL);
    showSelectedDiv();
  });
</script>
