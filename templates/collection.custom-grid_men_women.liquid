.product-card a { text-decoration:none; color:inherit; }
.product-image img { width:100%; height:auto; }
.product-title { font-weight:500; font-size:0.7rem; margin:5px 0; }
.product-price { font-size:1rem; margin:5px 0; display:none}
.compare-price { text-decoration:line-through; color:#777; font-size:0.9rem; margin-left:5px; }


.genuine-leather-badge {
    position: absolute;
    top: -7px;
    left: -15px;
    z-index: 2;
}
.genuine-leather-badge img {
  width: 60px;   /* adjust size */
  height: auto;
}

.vegan-badge{
  position: absolute;
    top: -7px;
    left: -15px;
    z-index: 2;
}

.vegan-badge img{
  width: 35px;   /* adjust size */
  height: auto;
  
}


#collection-loading {
  text-align: center;
  padding: 20px;
  font-weight: bold;
  display: none;
}
/* Best Seller text badge */
  .best-seller-badge {
