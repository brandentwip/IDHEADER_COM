{"sections":{"pf-c9accf10":{"type":"pf-c9accf10","disabled":true,"settings":{}},"advanced_content_yK4jCn":{"type":"advanced-content","blocks":{"html_wbxfpX":{"type":"html","settings":{"code":"<div class=\"lucky-draw-form-container\" style=\"max-width:500px;margin:auto;padding:20px;border:2px solid #b5dfce;border-radius:10px;background:#fff;\">\n  <h2 style=\"text-align:center;color:#000;\">Join Our Lucky Draw!<\/h2>\n  <p style=\"text-align:center;color:#333;\">Fill in your details and your invoice number to participate.<\/p>\n  \n  <form method=\"post\" action=\"\/contact#contact_form\" accept-charset=\"UTF-8\" id=\"lucky-draw-form\">\n    <input type=\"hidden\" name=\"form_type\" value=\"contact\">\n    <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n\n    <label for=\"LuckyName\" style=\"display:block;margin-top:15px;\">Name<\/label>\n    <input type=\"text\" name=\"contact[name]\" id=\"LuckyName\" required style=\"width:100%;padding:10px;border:1px solid #b5dfce;border-radius:5px;\">\n\n    <label for=\"LuckyEmail\" style=\"display:block;margin-top:15px;\">Email<\/label>\n    <input type=\"email\" name=\"contact[email]\" id=\"LuckyEmail\" required style=\"width:100%;padding:10px;border:1px solid #b5dfce;border-radius:5px;\">\n\n    <label for=\"LuckyInvoice\" style=\"display:block;margin-top:15px;\">Order Invoice Number<\/label>\n    <input type=\"text\" name=\"contact[body]\" id=\"LuckyInvoice\" placeholder=\"Enter your invoice number\" required style=\"width:100%;padding:10px;border:1px solid #b5dfce;border-radius:5px;\">\n\n    <button type=\"submit\" style=\"margin-top:20px;width:100%;padding:12px;background:#b5dfce;border:none;color:#000;font-weight:bold;border-radius:5px;cursor:pointer;\">Submit<\/button>\n  <\/form>\n<\/div>\n\n<script>\n  document.getElementById('lucky-draw-form').addEventListener('submit', function(e){\n    e.preventDefault();\n    var form = e.target;\n\n    fetch('\/contact', {\n      method: 'POST',\n      body: new FormData(form)\n    }).then(function(){\n      \/\/ Redirect to thank you page\n      window.location.href = '\/pages\/lucky-draw-thank-you';\n    }).catch(function(err){\n      alert('Something went wrong. Please try again.');\n    });\n  });\n<\/script>","width":"100%","alignment":"center"}}},"block_order":["html_wbxfpX"],"name":"Custom content","settings":{"full_width":true,"class_name":"","space_around":true}}},"order":["pf-c9accf10","advanced_content_yK4jCn"]}