.ph{\n    position:relative; min-height:260px;\n    background:var(--paper-2); border:1px solid var(--line);\n  }\n  .idc .ph::before{\n    content:\"\"; position:absolute; inset:0;\n    background:\n      linear-gradient(135deg, rgba(32,24,15,0.05) 25%, transparent 25%) -10px 0/20px 20px,\n      linear-gradient(225deg, rgba(32,24,15,0.05) 25%, transparent 25%) -10px 0/20px 20px;\n  }\n  .idc .ph .ph-tag{\n    position:absolute; bottom:12px; left:14px;\n    font-family:inherit !important; font-size:9px; letter-spacing:0.12em;\n    text-transform:uppercase; color:var(--ink-faint) !important;\n  }\n  .idc .split-media .text p{ font-size:15.5px; line-height:1.85; color:var(--ink-soft) !important; }\n  .idc .split-media .text p + p{ margin-top:14px; }\n  .idc .split-media .text h3{ font-size:22px; margin-bottom:16px; }\n\n  /* ---------- quote ---------- */\n  .idc .quote-block{ padding:100px 0; text-align:center; }\n  .idc .quote-block blockquote{\n    font-style:italic; font-weight:300; font-size:clamp(22px,2.8vw,30px);\n    line-height:1.6; max-width:680px; margin:0 auto; color:var(--ink) !important;\n  }\n\n  /* ---------- process list (manufacturing) ---------- */\n  .idc .process-list{ max-width:640px; margin:64px auto 0; }\n  .idc .process-row{\n    display:grid; grid-template-columns:48px 1fr; gap:20px;\n    padding:26px 0; border-top:1px solid var(--line);\n  }\n  .idc .process-row:last-child{ border-bottom:1px solid var(--line); }\n  .idc .process-row .num{ font-size:15px; }\n  .idc .process-row h3{ font-size:17px; font-weight:400; }\n\n  /* ---------- stat row ---------- */\n  .idc .stat-row{ display:flex; justify-content:center; gap:0; margin-top:64px; flex-wrap:wrap; }\n  .idc .stat{ padding:0 44px; text-align:center; }\n  .idc .stat + .stat{ border-left:1px solid var(--line); }\n  .idc .stat .num-big{ font-size:38px; font-weight:400; }\n  .idc .stat .lbl{ font-family:inherit !important; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-faint) !important; margin-top:8px; }\n\n  /* ---------- footer ---------- */\n  .idc footer{\n    padding:44px 0 60px; text-align:center;\n    font-family:inherit !important; font-size:10px; letter-spacing:0.14em;\n    text-transform:uppercase; color:var(--ink-faint) !important; border-top:1px solid var(--line); margin-top:40px;\n  }\n\n  @media (max-width: 800px){\n    .idc .icon-grid{ grid-template-columns:repeat(2,1fr); }\n    .idc .icon-grid.cols-4{ grid-template-columns:repeat(2,1fr); }\n    .idc .icon-grid.cols-3{ grid-template-columns:repeat(2,1fr); }\n    .idc .split-media, .idc .split-media.reverse{ grid-template-columns:1fr; direction:ltr; gap:24px; }\n    .idc .stat-row{ flex-direction:column; gap:28px; }\n    .idc .stat + .stat{ border-left:none; }\n    .idc .hero-media{ margin:20px 16px 0; height:56vh; }\n  }\n\n  @media (max-width: 420px){\n    .idc .wrap{ padding:0 20px; }\n    .idc .hero-media{ margin:16px 12px 0; height:48vh; min-height:340px; }\n    .idc .icon-grid,\n    .idc .icon-grid.cols-2,\n    .idc .icon-grid.cols-3,\n    .idc .icon-grid.cols-4{ grid-template-columns:1fr; gap:32px; max-width:none; }\n    .idc .intro{ padding:52px 0 40px; }\n    .idc .numsec{ padding:64px 0; }\n    .idc .stat{ padding:0 24px; }\n    .idc .quote-block{ padding:64px 0; }\n  }\n</style>\n\n<div class=\"idc\">\n\n<!-- shared icon svg defs -->\n<svg width=\"0\" height=\"0\" style=\"position:absolute\">\n<defs>\n<symbol id=\"ic-shield\" viewbox=\"0 0 40 40\"><path d=\"M20 4 L34 10 V19 C34 28 28 33 20 36 C12 33 6 28 6 19 V10 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-drop\" viewbox=\"0 0 40 40\"><path d=\"M20 6 C20 6 10 20 10 26 A10 10 0 0 0 30 26 C30 20 20 6 20 6 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-leaf\" viewbox=\"0 0 40 40\"><path d=\"M8 32 C8 16 24 8 34 8 C34 22 22 32 8 32 Z M8 32 C14 24 20 20 30 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-spark\" viewbox=\"0 0 40 40\"><path d=\"M20 6 L23 17 L34 20 L23 23 L20 34 L17 23 L6 20 L17 17 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-wave\" viewbox=\"0 0 40 40\"><path d=\"M6 22 C10 16 14 16 18 22 C22 28 26 28 30 22 C32 19 33 18 34 17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path><circle cx=\"20\" cy=\"12\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle></symbol>\n<symbol id=\"ic-check\" viewbox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle><path d=\"M14 20 L18 24 L26 15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-cushion\" viewbox=\"0 0 40 40\"><ellipse cx=\"20\" cy=\"24\" rx=\"14\" ry=\"8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></ellipse><path d=\"M8 24 C8 16 14 12 20 12 C26 12 32 16 32 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-air\" viewbox=\"0 0 40 40\"><circle cx=\"14\" cy=\"16\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle><circle cx=\"26\" cy=\"16\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle><circle cx=\"14\" cy=\"26\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle><circle cx=\"26\" cy=\"26\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle></symbol>\n<symbol id=\"ic-scale\" viewbox=\"0 0 40 40\"><path d=\"M20 6 V34 M10 12 H30 M10 12 L6 20 H14 Z M30 12 L26 20 H34 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-hand\" viewbox=\"0 0 40 40\"><path d=\"M12 22 V12 A2 2 0 0 1 16 12 V20 M16 20 V10 A2 2 0 0 1 20 10 V20 M20 20 V12 A2 2 0 0 1 24 12 V22 M24 20 A2 2 0 0 1 28 20 V26 C28 32 24 34 20 34 C15 34 12 31 12 26 V22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-hide\" viewbox=\"0 0 40 40\"><path d=\"M8 14 C12 10 18 10 20 14 C22 10 28 10 32 14 C34 20 30 30 20 32 C10 30 6 20 8 14 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-needle\" viewbox=\"0 0 40 40\"><path d=\"M10 30 L28 12 A3 3 0 0 1 32 16 L14 34 Z M8 32 L12 28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-thread\" viewbox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></circle><path d=\"M14 20 C16 16 24 24 26 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n<symbol id=\"ic-check2\" viewbox=\"0 0 40 40\"><path d=\"M8 20 L16 28 L32 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"></path></symbol>\n</defs>\n</svg>\n\n<!-- ============ 1. ABOUT ============ -->\n<section class=\"page idc-active\" id=\"about\">\n  <div class=\"eyebrow-top\">About ID</div>\n  <div class=\"hero-media\">\n    <span class=\"ph-tag\">Image — heritage / retail</span>\n    <div class=\"title-overlay\">Bringing the World's Best to India</div>\n  </div>\n\n  <div class=\"wrap intro\">\n    <div class=\"narrow\">\n      <p class=\"lede\">Building on a legacy that began with a single showroom and evolved into a chain of retail stores, our journey has always been driven by innovation, trust, and an unwavering commitment to exceptional footwear.</p>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\" style=\"padding-top:0;\">\n    <div class=\"split-media\">\n      <div class=\"ph\" style=\"height:420px;\"><span class=\"ph-tag\">Image — international partnerships</span></div>\n      <div class=\"text\">\n        <span class=\"label accent\">Our Foundation</span>\n        <h3 style=\"margin-top:12px;\">A new phase of growth</h3>\n        <p>Building on this foundation, the company entered a new phase of growth by representing and manufacturing for several renowned international footwear brands. These partnerships brought global design philosophies, advanced manufacturing techniques, and uncompromising quality standards into our ecosystem.</p>\n        <p>Decades of working alongside leading international names strengthened our expertise and established us as one of India's most experienced footwear manufacturers, laying the foundation for what iD represents today.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">The Birth of iD</span>\n      <h2>The Birth of iD</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p class=\"kicker\">With years of global experience behind us, we introduced iD with a bold vision—to create footwear that was unlike anything the Indian market had seen before.</p>\n      <p>At a time when footwear was largely limited to conventional black and brown styles, iD challenged the norm with vibrant sneakers in striking shades of red, blue, green, yellow, and beyond. Long before sneakers became a mainstream fashion category in India, iD helped pioneer the culture by bringing expressive, contemporary footwear to Indian consumers. The brand quickly developed a loyal following and earned a cult status among a generation that embraced individuality through style.</p>\n    </div>\n    <div class=\"split-media\">\n      <div class=\"text\">\n        <span class=\"label accent\">Expanding Our Capabilities</span>\n        <h3 style=\"margin-top:12px;\">Expanding Our Capabilities</h3>\n        <p>As the brand grew, so did our manufacturing capabilities. What began with premium men's footwear expanded into a comprehensive manufacturing ecosystem encompassing men's, women's, and children's footwear across multiple categories.</p>\n        <p>Backed by decades of technical expertise, world-class production facilities, and an uncompromising focus on quality, we evolved into a fully integrated footwear manufacturer, capable of serving diverse markets and consumer needs.</p>\n      </div>\n      <div class=\"ph\" style=\"height:420px;\"><span class=\"ph-tag\">Image — men's / women's / kids range</span></div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">The Legacy Continues</span>\n      <h2>The Legacy Continues</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p>Today, ID builds on decades of retail excellence, global partnerships, manufacturing expertise and continuous innovation. Every pair we create reflects the values that have defined us from the very beginning - craftsmanship, uncompromising quality and a relentless commitment to designing footwear that meets the needs of today while honouring a legacy built over generations.</p>\n      <p>Across India's diverse landscapes, cultures, and lifestyles, one thing remains constant - the need for footwear that combines style, comfort, and quality. This diversity inspires everything we create, allowing us to design footwear that blends fashion, comfort, and functionality for every Indian lifestyle.</p>\n    </div>\n    <div class=\"ph\" style=\"height:340px; margin-top:56px;\"><span class=\"ph-tag\">Picture4.jpg — ID for India</span></div>\n    <div class=\"numsec-body\" style=\"margin-top:40px;\">\n      <h2 style=\"font-style:italic; color:var(--tan);\">ID for India...</h2>\n    </div>\n  </div>\n\n  <div class=\"quote-block\" style=\"border-top:1px solid var(--line);\">\n    <span class=\"label\">Innovation, always</span>\n    <blockquote style=\"margin-top:20px;\">Innovation defines everything we do at ID.</blockquote>\n    <a class=\"intro idc-goto\" style=\"display:inline-block; padding:0;\" href=\"#tech\" data-target=\"tech\"><span class=\"cta-link\">See Technology</span></a>\n  </div>\n</section>\n\n<!-- ============ 2. TECHNOLOGY ============ -->\n<section class=\"page\" id=\"tech\">\n  <div class=\"eyebrow-top\">Tech</div>\n  <div class=\"hero-media\">\n    <span class=\"ph-tag\">Image — technology in motion</span>\n    <div class=\"title-overlay\">Innovation defines everything we do at ID</div>\n  </div>\n\n  <div class=\"wrap intro\">\n    <div class=\"narrow\">\n      <p>We believe exceptional footwear should seamlessly combine style, comfort, and intelligent functionality to enrich everyday life.</p>\n      <p style=\"margin-top:16px;\">Every pair is meticulously engineered with advanced comfort technologies, hands-free innovation, and freshness solutions that deliver effortless wear and uncompromising performance.</p>\n      <p style=\"margin-top:16px;\">By continually pushing the boundaries of footwear innovation, we create products that make every step lighter, smarter, and more comfortable.</p>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\" style=\"padding-top:0;\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">1.</span>\n      <h2>NODR<sup style=\"font-size:13px;\">®</sup> Technology</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p class=\"kicker\">Freshness is built into every pair of ID shoes with our proprietary NODR Technology.</p>\n      <p>Designed to deliver lasting freshness and enhanced hygiene, our advanced NODR Coating provides continuous protection throughout the day against the development of foot odour caused by multiple or long wears!</p>\n      <p><em>Powered by Four Essential Benefits.</em></p>\n    </div>\n    <div class=\"icon-grid\">\n      <div class=\"icon-item\">\n<div class=\"ico\"><svg><use href=\"#ic-spark\"></use></svg></div>\n<div class=\"cap\">Anti Odour Spray</div>\n<div class=\"cap-desc\">For lasting freshness, active protection from odour.</div>\n</div>\n      <div class=\"icon-item\">\n<div class=\"ico\"><svg><use href=\"#ic-shield\"></use></svg></div>\n<div class=\"cap\">Anti Bacterial Treatment</div>\n<div class=\"cap-desc\">Restricts the growth of bacteria.</div>\n</div>\n      <div class=\"icon-item\">\n<div class=\"ico\"><svg><use href=\"#ic-check\"></use></svg></div>\n<div class=\"cap\">Silver Inside</div>\n<div class=\"cap-desc\">100% natural and hypo allergenic pure silver, proven over centuries.</div>\n</div>\n      <div class=\"icon-item\">\n<div class=\"ico\"><svg><use href=\"#ic-leaf\"></use></svg></div>\n<div class=\"cap\">Fragrance</div>\n<div class=\"cap-desc\">Signature fragrance with mild citrus notes, micro encapsulated for extended life.</div>\n</div>\n    </div>\n    <div class=\"numsec-body\" style=\"margin-top:56px;\">\n      <p>The result is footwear that continues to feel fresh, comfortable, and enjoyable to wear - day after day.</p>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">2.</span>\n      <h2>56 Air Pocket Technology</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p class=\"kicker\">The soul of every shoe lies in its sole.</p>\n      <p>That belief inspired us to create our patented 56 Air Pocket Technology Soles.</p>\n      <p>Engineered for exceptional comfort, our patented 56 Air Pockets Air Cushion Technology is designed to absorb impact with every step. The innovative sole consisting of strategically placed air pockets that work independently, helps disperse shock and reduce pressure on your feet, delivering superior cushioning and lasting comfort throughout the day.</p>\n    </div>\n    <div class=\"split-media\">\n      <div class=\"ph\" style=\"height:340px;\"><span class=\"ph-tag\">Picture6 / Picture3 — sole cross-section</span></div>\n      <div class=\"text\" style=\"text-align:left;\">\n        <div class=\"icon-grid cols-2\" style=\"margin-top:0; text-align:left;\">\n          <div class=\"icon-item\" style=\"text-align:left;\">\n<div class=\"ico\" style=\"margin:0 0 10px;\"><svg><use href=\"#ic-cushion\"></use></svg></div>\n<div class=\"cap\">Absorbing Impact</div>\n</div>\n          <div class=\"icon-item\" style=\"text-align:left;\">\n<div class=\"ico\" style=\"margin:0 0 10px;\"><svg><use href=\"#ic-wave\"></use></svg></div>\n<div class=\"cap\">Reducing Pressure</div>\n</div>\n          <div class=\"icon-item\" style=\"text-align:left;\">\n<div class=\"ico\" style=\"margin:0 0 10px;\"><svg><use href=\"#ic-air\"></use></svg></div>\n<div class=\"cap\">Improving Airflow</div>\n</div>\n          <div class=\"icon-item\" style=\"text-align:left;\">\n<div class=\"ico\" style=\"margin:0 0 10px;\"><svg><use href=\"#ic-scale\"></use></svg></div>\n<div class=\"cap\">Even Weight Distribution</div>\n</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">3.</span>\n      <h2>Foot Reflexology</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p class=\"kicker\">The 56 Air Pocket System comes with the added benefits of Foot Reflexology</p>\n    </div>\n    <div class=\"icon-grid cols-3\">\n      <div class=\"icon-item\"><div class=\"cap\">Stimulates Foot Pressure Points</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Improves Blood Circulation</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Reduces Body Stiffness</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Helps Eliminate Body Toxins</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Improves Function of Body Organs</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Stimulates Vital Energy Flow</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Relaxation of Nerves</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Reduces Body & Mental Stress</div></div>\n      <div class=\"icon-item\"><div class=\"cap\">Helps Mood Upliftment</div></div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"split-media\">\n      <div class=\"text\">\n        <span class=\"label accent\">4.</span>\n        <h3 style=\"margin-top:12px;\">Ultra HD Insoles</h3>\n        <p style=\"font-size:17px; color:var(--ink);\">Comfort engineered to perform</p>\n        <p>Our Ultra HD Insoles feature an advanced High-Density Cushioning System that delivers superior comfort and stability.</p>\n        <p>The cushioned footbed naturally contours to your feet, creating an exceptionally soft underfoot experience that makes every step feel lighter.</p>\n        <p>The responsive cushioning rebounds with every step, promising enhanced energy return and lasting support throughout the day.</p>\n      </div>\n      <div class=\"ph\" style=\"height:380px;\"><span class=\"ph-tag\">Picture12.jpg — Ultra HD Insole</span></div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"split-media reverse\">\n      <div class=\"ph\" style=\"height:380px;\"><span class=\"ph-tag\">Picture3.jpg — Slide N Go heel grip</span></div>\n      <div class=\"text\">\n        <span class=\"label accent\">5.</span>\n        <h3 style=\"margin-top:12px;\">Slide N Go™ Technology</h3>\n        <p style=\"font-size:17px; color:var(--ink);\">Hands Free Convenience</p>\n        <p>Our Slide N Go™️ Technology redefines how premium leather footwear is worn.</p>\n        <p>A specially engineered Heel Grip structure allows your feet to glide effortlessly into your shoe completely Hands-Free, while securely holding your foot in place for a comfortable and stable fit.</p>\n        <p>Timeless elegance of premium leather footwear combined with the convenience of modern innovation.</p>\n        <p>While Hands-Free footwear has existed in casual and sports categories, ID is proud to be the first brand in India to introduce this innovation in premium leather footwear.</p>\n        <p style=\"font-style:italic; font-size:19px; color:var(--tan); margin-top:20px;\">Step in. Move on.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"quote-block\" style=\"border-top:1px solid var(--line);\">\n    <span class=\"label\">Materials, next</span>\n    <blockquote style=\"margin-top:20px;\">Exceptional footwear begins with exceptional materials.</blockquote>\n    <a class=\"intro idc-goto\" style=\"display:inline-block; padding:0;\" href=\"#materials\" data-target=\"materials\"><span class=\"cta-link\">See Materials</span></a>\n  </div>\n</section>\n\n<!-- ============ 3. MATERIALS ============ -->\n<section class=\"page\" id=\"materials\">\n  <div class=\"eyebrow-top\">Premium Materials</div>\n  <div class=\"hero-media\">\n    <span class=\"ph-tag\">Image — leather hide, macro texture</span>\n    <div class=\"title-overlay\">Exceptional footwear begins with exceptional materials</div>\n  </div>\n\n  <div class=\"wrap intro\">\n    <div class=\"narrow\">\n      <p>At ID, every material is carefully sourced and selected for its comfort, durability, performance and style. Each material is matched to the right product and rigorously tested before becoming part of an ID shoe.</p>\n      <p style=\"margin-top:16px;\">Every material implemented in our footwear is tested for durability, flexibility, abrasion resistance, colour fastness and finish before it is approved for production.</p>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\" style=\"padding-top:0;\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">1.</span>\n      <h2>Genuine Leather</h2>\n    </div>\n    <div class=\"numsec-body\">\n      <p class=\"kicker\">Genuine Leather Footwear has been at the heart of ID. It is our heritage, our expertise, and the foundation on which our reputation has been built.</p>\n      <p>Crafting exceptional Leather Footwear is more than a manufacturing process - it begins with understanding Leather itself.</p>\n      <p>Decades of experience have given us the expertise to identify, source and work with the finest selection of Leathers for every style, to deliver outstanding comfort, breathability, durability and finish.</p>\n      <p>Every Leather Footwear at ID carries a Genuine Leather tag, assuring you of its authenticity. For generations, customers across India have trusted ID for Premium Leather Footwear. It's a legacy built on quality, craftsmanship, and an unwavering commitment to create some of the finest Leather Footwear in the Country.</p>\n    </div>\n    <div class=\"ph\" style=\"height:280px; margin-top:56px; max-width:420px; margin-left:auto; margin-right:auto;\"><span class=\"ph-tag\">Genuine Leather tag — creative</span></div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">2.</span>\n      <h2>Types of Genuine Leather</h2>\n    </div>\n    <div class=\"process-list\">\n      <div class=\"process-row\">\n<div class=\"num\">Nappa</div>\n<div>\n<h3>Luxuriously Soft</h3>\n<p style=\"font-size:14px; color:var(--ink-soft); margin-top:4px;\">Ideal for Premium Formal and Dress Footwear.</p>\n</div>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">Crumbled</div>\n<div>\n<h3>Rich Natural Texture</h3>\n<p style=\"font-size:14px; color:var(--ink-soft); margin-top:4px;\">Distinctive character. Ideal for Casual Footwear and Boots.</p>\n</div>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">Washed</div>\n<div>\n<h3>Aged Feel</h3>\n<p style=\"font-size:14px; color:var(--ink-soft); margin-top:4px;\">Ideal for Loafers and Casual Footwear.</p>\n</div>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">Crust</div>\n<div>\n<h3>Natural Hand Finished Leather</h3>\n<p style=\"font-size:14px; color:var(--ink-soft); margin-top:4px;\">Ideal for Premium Formal Footwear.</p>\n</div>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">Tie & Dye</div>\n<div>\n<h3>Unique Artisan Finish</h3>\n<p style=\"font-size:14px; color:var(--ink-soft); margin-top:4px;\">Ideal for Fashion and Limited-Edition Footwear.</p>\n</div>\n</div>\n    </div>\n    <div class=\"icon-grid cols-3\" style=\"margin-top:64px;\">\n      <div class=\"icon-item\"><div class=\"ph\" style=\"height:120px;\"><span class=\"ph-tag\">Nappa swatch</span></div></div>\n      <div class=\"icon-item\"><div class=\"ph\" style=\"height:120px;\"><span class=\"ph-tag\">Crumbled swatch</span></div></div>\n      <div class=\"icon-item\"><div class=\"ph\" style=\"height:120px;\"><span class=\"ph-tag\">Washed swatch</span></div></div>\n      <div class=\"icon-item\"><div class=\"ph\" style=\"height:120px;\"><span class=\"ph-tag\">Crust swatch</span></div></div>\n      <div class=\"icon-item\"><div class=\"ph\" style=\"height:120px;\"><span class=\"ph-tag\">Tie & Dye swatch</span></div></div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"split-media\">\n      <div class=\"ph\" style=\"height:300px;\"><span class=\"ph-tag\">ID Vegan badge</span></div>\n      <div class=\"text\">\n        <span class=\"label accent\">3.</span>\n        <h3 style=\"margin-top:12px;\">Vegan Leather</h3>\n        <p>As customer preferences continue to evolve, so does ID.</p>\n        <p>Our growing range of Vegan Leather footwear reflects our commitment to offering premium alternatives without compromising on quality, comfort or style.</p>\n        <p>Crafted using carefully selected Vegan materials, every pair is designed with the same attention to detail and craftsmanship that defines all ID Footwear.</p>\n        <p>Every ID Vegan collection is thoughtfully developed, carefully authenticated, and can be easily identified on our website with the ID Vegan badge, giving customers the confidence to choose footwear that aligns with their lifestyle and values.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"quote-block\" style=\"border-top:1px solid var(--line);\">\n    <span class=\"label\">A legacy in shoemaking</span>\n    <blockquote style=\"margin-top:20px;\">For decades, ID has remained guided by one enduring belief.</blockquote>\n    <a class=\"intro idc-goto\" style=\"display:inline-block; padding:0;\" href=\"#manufacturing\" data-target=\"manufacturing\"><span class=\"cta-link\">See Manufacturing</span></a>\n  </div>\n</section>\n\n<!-- ============ 4. MANUFACTURING ============ -->\n<section class=\"page\" id=\"manufacturing\">\n  <div class=\"eyebrow-top\">Manufacturing Capabilities</div>\n  <div class=\"hero-media\">\n    <span class=\"ph-tag\">Image — shoemaking</span>\n    <div class=\"title-overlay\">A Legacy in Shoemaking</div>\n  </div>\n\n  <div class=\"wrap intro\">\n    <div class=\"narrow\">\n      <p>For decades, ID has remained guided by one enduring belief - that exceptional footwear can only be created by those who truly understand the craft of shoemaking.</p>\n      <p style=\"margin-top:16px;\">Driven by this philosophy, we have delivered over 50 million pairs to Happy Customers across India.</p>\n      <p style=\"margin-top:16px;\">Our commitment to craftsmanship and design excellence has earned us numerous industry accolades, reinforcing ID's reputation as one of India's most trusted and respected footwear brand.</p>\n    </div>\n    <div class=\"stat-row\">\n      <div class=\"stat\">\n<div class=\"num-big\">50M+</div>\n<div class=\"lbl\">Pairs Delivered</div>\n</div>\n      <div class=\"stat\">\n<div class=\"num-big\">50+</div>\n<div class=\"lbl\">Years of Craftsmanship</div>\n</div>\n      <div class=\"stat\">\n<div class=\"num-big\">100%</div>\n<div class=\"lbl\">In-House Manufacturing</div>\n</div>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\" style=\"padding-top:0;\">\n    <div class=\"split-media\">\n      <div class=\"ph\" style=\"height:360px;\"><span class=\"ph-tag\">Image — machinery</span></div>\n      <div class=\"text\">\n        <span class=\"label accent\">A Promise of Quality</span>\n        <h3 style=\"margin-top:12px;\">A Promise of Quality</h3>\n        <p>Our manufacturing expertise has been built over decades of continuous learning, investment and innovation.</p>\n        <p>By combining skilled craftsmanship with advanced technology and world-class manufacturing facilities, we create footwear that meets the highest standards of quality, comfort, and durability.</p>\n        <p>From sourcing the finest materials to the final packaging, every stage of our manufacturing process is carried out with precision and purpose.</p>\n        <p>Each pair undergoes rigorous quality checks before it proudly reaches our customers.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"quote-block\" style=\"border-top:1px solid var(--line); border-bottom:1px solid var(--line);\">\n    <span class=\"label\">Designed. Developed. Made by ID</span>\n    <blockquote style=\"margin-top:20px;\">Simply put, what you buy from ID is made by ID.</blockquote>\n    <div class=\"narrow\" style=\"margin-top:36px;\">\n      <p style=\"font-size:15.5px; line-height:1.85; color:var(--ink-soft);\">Every pair of ID footwear is designed, developed, and manufactured in-house, giving us complete control over every stage - from material selection, product development to finishing and quality assurance.</p>\n      <p style=\"font-size:15.5px; line-height:1.85; color:var(--ink-soft); margin-top:16px;\">By combining skilled craftsmanship with advanced manufacturing technologies, we consistently deliver footwear that meets the highest standards of quality, comfort and durability.</p>\n      <p style=\"font-size:15.5px; line-height:1.85; color:var(--ink-soft); margin-top:16px;\">This commitment to in-house manufacturing has earned the trust of generations and continues to define everything we produce.</p>\n    </div>\n  </div>\n\n  <div class=\"wrap numsec\">\n    <div class=\"numsec-head\">\n      <span class=\"num\">The Journey</span>\n      <h2>Journey of a shoe through our eyes</h2>\n    </div>\n    <div class=\"process-list\">\n      <div class=\"process-row\">\n<div class=\"num\">01</div>\n<h3>Design and Pattern Making</h3>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">02</div>\n<h3>Cutting</h3>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">03</div>\n<h3>Closing</h3>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">04</div>\n<h3>Lasting and Sole Attachment</h3>\n</div>\n      <div class=\"process-row\">\n<div class=\"num\">05</div>\n<h3>Finishing and Quality Control</h3>\n</div>\n    </div>\n    <div class=\"ph\" style=\"height:360px; margin-top:64px;\"><span class=\"ph-tag\">\"Video of factory\" — placeholder</span></div>\n  </div>\n</section>\n\n<footer>© 2026 IDCult. All Rights Reserved.</footer>\n\n</div>\n\n<script>\n(function(){\n  var root = document.currentScript.previousElementSibling; // the .idc wrapper\n  if(!root || !root.classList.contains('idc')){\n    root = document.querySelector('.idc');\n  }\n  var pages = root.querySelectorAll('section.page');\n  var links = root.querySelectorAll('.idc-goto');\n\n  function showPage(id){\n    pages.forEach(function(p){\n      p.classList.toggle('idc-active', p.id === id);\n    });\n    window.scrollTo({top:0, behavior:'instant'});\n  }\n\n  links.forEach(function(link){\n    link.addEventListener('click', function(e){\n      e.preventDefault();\n      showPage(link.getAttribute('data-target'));\n    });\n  });\n})();\n</script>",
            "width": "100%",
            "alignment": "center"
          }
        }
