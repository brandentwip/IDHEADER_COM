            "code": "<!-- ============================================================\n     ID · CULT — About / Technology / Materials / Manufacturing\n     Paste this into Shopify: Online Store > Pages > Add page > \n     Content > \"</>\" (Show HTML) source code view.\n     Navbar removed (theme nav is used instead) — all four sections\n     now flow as one continuous page, linked by the \"See ...\" CTAs.\n     Fonts inherit from your theme (no external font import).\n     ============================================================ -->\n<style>\n  .idc{\n    --ink:#20180F;\n    --ink-soft:rgba(32,24,15,0.68);\n    --ink-faint:rgba(32,24,15,0.42);\n    --paper:#FBFAF7;\n    --paper-2:#F2EEE6;\n    --tan:#8C5A34;\n    --line:rgba(32,24,15,0.12);\n    background:var(--paper);\n    color:var(--ink) !important;\n    font-family:inherit !important;\n    font-weight:300;\n  }\n  .idc *{ box-sizing:border-box; }\n  .idc{ scroll-behavior:smooth; }\n  .idc h1,.idc h2,.idc h3{ font-weight:400; margin:0; font-family:inherit !important; color:var(--ink) !important; }\n\n  /* break out of the theme's narrow, centered page container */\n  .idc{\n    width:100vw !important;\n    max-width:100vw !important;\n    position:relative !important;\n    left:50% !important;\n    right:50% !important;\n    margin-left:-50vw !important;\n    margin-right:-50vw !important;\n  }\n  .idc .num{ font-weight:300; color:var(--ink-faint) !important; font-size:13px; }\n  .idc .label{\n    font-family:inherit !important;\n    font-size:10.5px;\n    letter-spacing:0.22em;\n    text-transform:uppercase;\n    font-weight:600;\n    color:var(--ink-faint) !important;\n  }\n  .idc .label.accent{ color:var(--tan) !important; }\n  .idc a{ color:inherit !important; text-decoration:none; }\n\n  .idc section.page{ display:none; }\n  .idc section.page.idc-active{ display:block; }\n\n  .idc .wrap{ max-width:1080px; margin:0 auto; padding:0 32px; }\n  .idc .narrow{ max-width:640px; margin:0 auto; text-align:cen