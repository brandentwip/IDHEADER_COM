{% comment %}
  Testimonial Slider Section (Auto-slide, no buttons)
{% endcomment %}

<section class="tg-testimonials">
  <div class="tg-bg-blur" aria-hidden="true"></div>

  <div class="tg-wrap">
    <!-- Left/Slider column -->
    <div class="tg-slider-col">
      <div class="tg-slider-viewport">
        <div class="tg-slider-track">
          {% for block in section.blocks %}
            <article 
              class="tg-card"
              data-author="{{ block.settings.name | escape }}"
              data-role="{{ block.settings.role | escape }}"
              data-text="{{ block.settings.text | escape }}"
              data-image="{{ block.settings.image | image_url: width: 1400 }}">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 900 }}" 
                  alt="{{ block.settings.name | escape }}">
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Right/testimonial column -->
    <aside class="tg-info-col" aria-live="polite">
      <div class="tg-person">
        <img class="tg-avatar" src="https://via.placeholder.com/60" alt="author avatar">
        <div class="tg-meta">
          <div class="tg-name">Name</div>
          <div class="tg-role">Role</div>
        </div>
      </div>
      <div class="tg-text">
        <p class="tg-body">Testimonial text goes here — will update with active slide.</p>
      </div>
    </aside>
  </div>
</section>

<style>
:root{
  --max-w: 1220px;
  --bg: #070707;
  --card-h: 520px;
}
.tg-testimonials{
  position: relative;
  background: var(--bg);
  color: #fff;
  padding: 36px 18px;
  overflow: hidden;
}
.tg-bg-blur{
  position:absolute; inset:0;
  background-size:cover;
  background-position:center;
  filter: blur(14px) brightness(.36) saturate(.7);
  transform: scale(1.06);
  z-index:0;
  transition: background-image .6s ease;
}
.tg-wrap{
  position:relative;
  z-index:2;
  max-width: var(--max-w);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 30px;
  align-items: center;
  min-height: calc(var(--card-h) + 20px);
}
.tg-slider-col{ position: relative; }
.tg-slider-viewport{
  overflow: hidden;
  width: 100%;
  border-radius: 10px;
}
.tg-slider-track{
  display:flex;
  align-items:center;
  gap: 26px;
  transition: transform .6s cubic-bezier(.2,.9,.3,1);
  will-change: transform;
  padding: 18px;
}
.tg-card{
  flex: 0 0 360px;
  border-radius: 8px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.015));
  box-shadow: 0 18px 40px rgba(0,0,0,0.6);
  transform-origin: center;
  transition: transform .45s ease, opacity .45s ease;
}
.tg-card img{
  width:100%;
  height: var(--card-h);
  object-fit: cover;
  display:block;
}
.tg-card { opacity: .92; }
.tg-card.active { transform: scale(1.06); opacity:1; }
.tg-card:not(.active) { transform: scale(.92); }
.tg-info-col{
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  padding: 26px;
  border-radius: 8px;
  display:flex;
  flex-direction:column;
  justify-content: center;
  gap: 18px;
  min-height: var(--card-h);
  position: relative;
}
.tg-person{ display:flex; align-items:center; gap:12px; }
.tg-avatar{ width:60px; height:60px; border-radius:8px; object-fit:cover; box-shadow:0 6px 18px rgba(0,0,0,.5); }
.tg-name{ font-weight:700; font-size:16px; }
.tg-role{ font-size:13px; color: #bbb; margin-top:2px; }
.tg-body{ font-size:14px; line-height:1.6; color: #ddd; margin:0; }

/* Remove nav button styles entirely */
.tg-nav{ display:none !important; }

@media (max-width: 1100px){
  :root{ --card-h: 440px; }
  .tg-wrap{ grid-template-columns: 1fr 340px; gap:20px; }
  .tg-card{ flex-basis: 320px; }
}
@media (max-width: 820px){
  .tg-wrap{ grid-template-columns: 1fr; gap:18px; padding-bottom: 6px; }
  .tg-info-col{ order: 2; min-height: auto; padding:20px; }
  .tg-slider-col{ order:1; }
  .tg-card img{ height: 420px; }
}
@media (max-width: 480px){
  :root{ --card-h: 300px; }
  .tg-card{ flex-basis: 100%; }
  .tg-slider-track{ gap:14px; padding:12px; }
  .tg-card img{ height: 300px; }
  .tg-person .tg-avatar{ width:48px; height:48px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const track = document.querySelector('.tg-slider-track');
  const cards = Array.from(document.querySelectorAll('.tg-card'));
  const bg = document.querySelector('.tg-bg-blur');
  const nameEl = document.querySelector('.tg-name');
  const roleEl = document.querySelector('.tg-role');
  const bodyEl = document.querySelector('.tg-body');
  const avatarEl = document.querySelector('.tg-avatar');
  let idx = 1;
  let autoTimer = null;
  const gap = 26;

  function clamp(v, a, b){ return Math.max(a, Math.min(b, v)); }

  function updateLayout() {
    const viewport = document.querySelector('.tg-slider-viewport');
    if (!viewport) return;
    const viewportW = viewport.clientWidth;
    const cardW = cards[0].offsetWidth;
    const trackPadding = 18;
    let translate = (cardW + gap) * idx - (viewportW/2) + (cardW/2) + trackPadding;
    const maxTranslate = Math.max(0, (cardW + gap) * (cards.length - 1) + trackPadding - viewportW + (gap/2));
    translate = clamp(translate, 0, maxTranslate);
    track.style.transform = `translateX(-${translate}px)`;
    cards.forEach((c,i)=> c.classList.toggle('active', i === idx));
    const active = cards[idx];
    if (active) {
      const imgUrl = active.dataset.image || active.querySelector('img')?.src || '';
      const author = active.dataset.author || 'Customer';
      const role = active.dataset.role || '';
      const text = active.dataset.text || '';
      bg.style.backgroundImage = `url("${imgUrl}")`;
      bodyEl.textContent = text;
      nameEl.textContent = author;
      roleEl.textContent = role;
      avatarEl.src = active.querySelector('img')?.src || avatarEl.src;
      avatarEl.alt = author;
    }
  }

  function go(n) { idx = clamp(n, 0, cards.length - 1); updateLayout(); resetAuto(); }
  function startAuto(){ stopAuto(); autoTimer = setInterval(()=> { idx = (idx + 1) % cards.length; updateLayout(); }, 4500); }
  function stopAuto(){ if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
  function resetAuto(){ stopAuto(); startAuto(); }

  // Cards are clickable to focus
  cards.forEach((c,i)=> c.addEventListener('click', ()=> go(i)));

  window.addEventListener('resize', ()=> setTimeout(updateLayout, 120));
  window.addEventListener('load', ()=> { if (idx >= cards.length) idx = cards.length-1; updateLayout(); startAuto();});
  cards.forEach(imgCard => { const img = imgCard.querySelector('img'); if (img && !img.complete) img.addEventListener('load', updateLayout); });
});
</script>

{% schema %}
{
  "name": "Testimonial Slider",
  "settings": [],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "textarea", "id": "text", "label": "Testimonial text" }
      ]
    }
  ],
  "presets": [
    { "name": "Testimonial Slider", "category": "Testimonials" }
  ]
}
{% endschema %}
