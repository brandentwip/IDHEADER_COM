{{ 'https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css' | stylesheet_tag }}

<section class="ph-section">
  <div class="page-width">

    <div class="ph-wrapper">

      <!-- Left -->
      <div class="ph-left">
        <h3>{{ section.settings.heading }}</h3>

        <div class="ph-grid">
          {% for block in section.blocks %}
            {% if block.type == 'highlight' %}
              <div class="ph-card" {{ block.shopify_attributes }}>
                <i class="{{ block.settings.icon }}"></i>
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- Right -->
      <div class="ph-right">

        {% for block in section.blocks %}
          {% if block.type == 'service' %}
            <div class="ph-service" {{ block.shopify_attributes }}>
              <i class="{{ block.settings.icon }}"></i>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}

      </div>

    </div>

  </div>
</section>

<style>
.ph-section{
  margin:40px 0;
}

.ph-wrapper{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:24px;
  align-items:start;
}

.ph-left{
  border:1px solid #ececec;
  border-radius:14px;
  padding:22px;
}

.ph-left h3{
  margin:0 0 18px;
  font-size:18px;
  font-weight:700;
}

.ph-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.ph-card{
  display:flex;
  align-items:center;
  gap:14px;
  background:#f8f8f8;
  border-radius:10px;
  padding:18px;
}

.ph-card i{
  font-size:30px;
  color:#111;
}

.ph-card span{
  font-size:15px;
  font-weight:500;
  line-height:1.4;
}

.ph-right{
  background:#f8f8f8;
  border-radius:14px;
  padding:18px 22px;
}

.ph-service{
  display:flex;
  align-items:center;
  gap:14px;
  padding:18px 0;
}

.ph-service + .ph-service{
  border-top:1px solid #e6e6e6;
}

.ph-service i{
  font-size:24px;
  color:#111;
}

.ph-service span{
  font-size:15px;
  font-weight:500;
}

@media(max-width:990px){

  .ph-wrapper{
    grid-template-columns:1fr;
  }

  .ph-grid{
    grid-template-columns:1fr;
  }

}
</style>

{% schema %}
{
  "name": "Product Highlights",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Highlights"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Remix Icon Class",
          "default": "ri-calendar-line"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "All Day Wear"
        }
      ]
    },
    {
      "type": "service",
      "name": "Service",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Remix Icon Class",
          "default": "ri-checkbox-circle-line"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cash on Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Highlights",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "icon": "ri-calendar-line",
            "text": "All Day Wear"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "ri-ruler-line",
            "text": "15% Wider Toe Box"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "ri-shield-check-line",
            "text": "Wear & Repeat"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "ri-checkbox-circle-line",
            "text": "Cash on Delivery"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "ri-box-3-line",
            "text": "Next Day Dispatch"
          }
        }
      ]
    }
  ]
}
{% endschema %}