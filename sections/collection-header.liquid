{%- assign disable_sticky_header = false -%}

{%- if section.settings.enable -%}
  {%- if section.settings.collection_image_enable and collection.image -%}
    <div
      id="CollectionHeaderSection"
      data-section-id="{{ section.id }}"
      data-section-type="collection-header"
      {% if section.settings.parallax %}data-parallax="true"{% endif %}>

      {%- assign img_url = collection.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

      <div class="collection-hero">

        {%- if section.settings.parallax -%}
          <div class="parallax-container">
            <div class="parallax-image">
        {%- endif -%}

          <img class="collection-hero__image image-fit lazyload"
            src=""
            data-src="{{ img_url }}"
            data-aspectratio="{{ collection.image.aspect_ratio }}"
            data-widths="[720, 900, 1080, 1800, 2400]"
            data-sizes="auto"
            alt="{{ collection.image.alt | escape }}">

          <noscript>
            <img class="collection-hero__image image-fit"
              src="{{ collection.image | img_url: '1400x' }}"
              alt="{{ collection.image.alt | escape }}">
          </noscript>

        {%- if section.settings.parallax -%}
            </div>
          </div>
        {%- endif -%}

        <div class="collection-hero__content">
          <div class="page-width">
            <header class="section-header section-header--hero">
              <div class="section-header__shadow">
               
                <h1 class="section-header__title">
                  {{ collection.title }}
                </h1>
                 {%- render 'breadcrumbs' -%}
              </div>
            </header>
          </div>
        </div>
      </div>
    </div>
  {%- else -%}
    {%- assign disable_sticky_header = true -%}
    <div class="page-width page-content page-content--top">

      {% if collection.id == 403901251832 %}
        <!-- <img src="https://cdn.shopify.com/s/files/1/0636/5128/3192/files/ID_Retro_Bag_Shoe.jpg?v=1720788930" class="desktop-clp" width="100%">
        <img src="https://cdn.shopify.com/s/files/1/0636/5128/3192/files/ID_Retro_Bag_Shoe_mobile.jpg?v=1720788930" width="100%" class="Mobile-clp" style="display:none;"> -->
      
      <header class="section-header section-header--flush" style="display:none;">        
        <h1 class="section-header__title">
          {{ collection.title }}
        </h1>
        {%- render 'breadcrumbs' -%}
      </header>

      {% elsif collection.id == 394399940856 %}
          <img src="https://cdn.shopify.com/s/files/1/0636/5128/3192/files/image.webp?v=1749721298" class="desktop-clp" width="100%">
          <img src="https://cdn.shopify.com/s/files/1/0636/5128/3192/files/ID_Formal_Mobile__1.jpg?v=1716982148" width="100%" class="Mobile-clp" style="display:none;">
 

           <!-- Title + breadcrumbs added here -->

        <header class="section-header section-header--flush">        

          <h1 class="section-header__title">

            {{ collection.title }}

          </h1>

          {%- render 'breadcrumbs' -%}

        </header>
        {% else %}

<header class="section-header section-header--flush" >        
        <h1 class="section-header__title">
          {{ collection.title }}
        </h1>
        {%- render 'breadcrumbs' -%}
      </header>

      {% endif %}
    </div>
  {%- endif -%}
{% else %}
  {%- assign disable_sticky_header = true -%}
{%- endif -%}

{%- if disable_sticky_header -%}
  {% comment %}
    Div to trigger theme.CollectionHeader JS
  {% endcomment %}
  <div
    id="CollectionHeaderSection"
    data-section-id="{{ section.id }}"
    data-section-type="collection-header">
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Collection header",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable",
        "label": "Enable header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "collection_image_enable",
        "label": "Show collection image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "parallax",
        "label": "Parallax image",
        "default": true
      }
    ]
  }
{% endschema %}
