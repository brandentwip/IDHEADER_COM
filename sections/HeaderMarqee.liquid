{% comment %}
  Repeating Marquee Header Section
{% endcomment %}

<div class="marquee-header">
  <div class="marquee-track">
    {% for i in (1..6) %}
      <span class="marquee-text">
        For any queries please contact our customer care at 
        <a href="tel:+919910433300">+91 9910433300</a>
      </span>
    {% endfor %}
  </div>
</div>

<style>
  .marquee-header {
    width: 100%;
    overflow: hidden;
    background: #000;
    padding: 10px 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 18s linear infinite;
  }

  .marquee-text {
    white-space: nowrap;
    color: #fff;
    font-size: 14px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    padding-right: 60px;
  }

  .marquee-text a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Pause on hover (optional but nice) */
  .marquee-header:hover .marquee-track {
    animation-play-state: paused;
  }
</style>

{% schema %}
{
  "name": "Marquee Header Text",
  "settings": [],
  "presets": [
    {
      "name": "Marquee Header"
    }
  ]
}
{% endschema %}
