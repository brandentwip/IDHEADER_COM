{% stylesheet %}
  .fgb-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:{{ section.settings.gap }}px}
  .fgb-card{position:relative;overflow:hidden;border-radius:{{ section.settings.radius }}px;display:block;height:{{ section.settings.height }}px}
  .fgb-card img{width:100%;height:100%;object-fit:cover;transition:.5s}
  
  .fgb-overlay{position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }})}
  .fgb-content{position:absolute;left:50%;bottom:30px;transform:translateX(-50%);text-align:center;color:{{ section.settings.text_color }};z-index:2}
  .fgb-title{font-size:{{ section.settings.heading_size }}px;font-weight:800;line-height:.9;text-transform:uppercase}
  @media(max-width:749px){
  .fgb-grid{grid-template-columns:1fr}
  .fgb-card{height:{{ section.settings.mobile_height }}px}
  }
{% endstylesheet %}

<div class="fgb-grid">
  {% for block in section.blocks %}
    <a class="fgb-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      {% assign img = block.settings.image %}
      {% if block.settings.mobile_image != blank %}
        <picture>
          <source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width:900 }}">
          {{ img | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        </picture>
      {% else %}
        {{ img | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      {% endif %}
      <div class="fgb-overlay"></div>
      <div class="fgb-content">
        <div class="fgb-title">{{ block.settings.heading | newline_to_br }}</div>
      </div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Fashion Grid Banner",
  "settings": [
    { "type": "range", "id": "height", "min": 300, "max": 800, "step": 20, "default": 620, "label": "Desktop height" },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 250,
      "max": 600,
      "step": 10,
      "default": 420,
      "label": "Mobile height"
    },
    { "type": "range", "id": "gap", "min": 0, "max": 40, "step": 2, "default": 0, "label": "Gap" },
    { "type": "range", "id": "radius", "min": 0, "max": 30, "step": 2, "default": 0, "label": "Corner radius" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "default": 15, "label": "Overlay opacity" },
    { "type": "color", "id": "text_color", "default": "#ffffff", "label": "Text color" },
    { "type": "range", "id": "heading_size", "min": 24, "max": 80, "step": 2, "default": 48, "label": "Heading size" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "NEW\nARRIVALS" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Fashion Grid Banner", "blocks": [{ "type": "banner" }, { "type": "banner" }, { "type": "banner" }] }
  ]
}
{% endschema %}
