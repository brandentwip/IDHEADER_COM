{%- comment -%}
  Section: Comparing With Others
  Split visual comparison — genuine leather product photo on the left,
  generic outline artwork on the right, with editable comparison rows below.
  Rows = blocks, fully editable via theme customizer.
{%- endcomment -%}

<div class="cwo-section-{{ section.id }} cwo-section" style="background:{{ section.settings.bg_color }};">

  {%- if section.settings.heading != blank -%}
    <h2 class="cwo-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="cwo-labels">
    <div class="cwo-brand-logo">
      {%- if section.settings.logo_image != blank -%}
        <img
          class="cwo-brand-logo-img"
          src="{{ section.settings.logo_image | image_url: width: 200 }}"
          alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="cwo-mark">
          <span></span>
          <span class="cwo-big-d">{{ section.settings.logo_text | default: 'iD' }}</span>
        </div>
        {%- if section.settings.logo_subtext != blank -%}
          <div class="cwo-logo-text">
            <span class="cwo-since">{{ section.settings.logo_subtext }}</span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="cwo-others-label">{{ section.settings.others_label | default: 'Others' }}</div>
  </div>

  <div class="cwo-split-visual">
    {%- if section.settings.leather_image != blank -%}
      <img
        src="{{ section.settings.leather_image | image_url: width: 1080 }}"
        srcset="
          {{ section.settings.leather_image | image_url: width: 540 }} 540w,
          {{ section.settings.leather_image | image_url: width: 1080 }} 1080w,
          {{ section.settings.leather_image | image_url: width: 1600 }} 1600w
        "
        sizes="(max-width: 640px) 300px, 480px"
        alt="{{ section.settings.leather_image.alt | default: 'Genuine leather shoe' | escape }}"
        width="{{ section.settings.leather_image.width }}"
        height="{{ section.settings.leather_image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="cwo-split-visual-placeholder">
        {{ 'shoe-1' | placeholder_svg_tag: 'cwo-placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if section.settings.outline_image != blank -%}
      <img
        src="{{ section.settings.outline_image | image_url: width: 1080 }}"
        srcset="
          {{ section.settings.outline_image | image_url: width: 540 }} 540w,
          {{ section.settings.outline_image | image_url: width: 1080 }} 1080w,
          {{ section.settings.outline_image | image_url: width: 1600 }} 1600w
        "
        sizes="(max-width: 640px) 300px, 480px"
        alt="{{ section.settings.outline_image.alt | default: 'Generic outline shoe comparison' | escape }}"
        width="{{ section.settings.outline_image.width }}"
        height="{{ section.settings.outline_image.height }}"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <div class="cwo-rows">
    <div class="cwo-col cwo-dark">
      {%- for block in section.blocks -%}
        <div class="cwo-row" {{ block.shopify_attributes }}>{{ block.settings.left_text }}</div>
      {%- endfor -%}
    </div>
    <div class="cwo-col cwo-light">
      {%- for block in section.blocks -%}
        <div class="cwo-row" {{ block.shopify_attributes }}>{{ block.settings.right_text }}</div>
      {%- endfor -%}
    </div>
  </div>

</div>

<style>
  .cwo-section{
    --cwo-dark: #2b2b2b;
    --cwo-dark-text: #ffffff;
    --cwo-light-bg: #eeeeee;
    --cwo-light-text: #1a1a1a;
    --cwo-accent-gold: #d4a017;
    --cwo-line: rgba(0,0,0,0.15);
    --cwo-line-on-dark: rgba(255,255,255,0.15);

    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px 60px;
  }

  .cwo-section *{ box-sizing: border-box; }

  .cwo-heading{
    text-align:center;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
    color: #111;
    margin: 0 0 40px;
    text-transform: uppercase;
  }

  /* ---------- Logo / Others row ---------- */
  .cwo-labels{
    display:grid;
    grid-template-columns: 1fr 1fr;
    align-items:center;
    margin-bottom: 10px;
  }

  .cwo-brand-logo{
    display:flex;
    align-items:center;
    gap: 4px;
    padding-left: 10px;
  }
  .cwo-brand-logo-img{
    max-width: 160px;
    height: auto;
  }
  .cwo-mark{
    display:flex;
    flex-direction:column;
    line-height:0.75;
  }
  .cwo-mark span:first-child{
    width: 22px;
    height: 6px;
    background: var(--cwo-accent-gold);
    margin-bottom: 4px;
  }
  .cwo-mark .cwo-big-d{
    font-size: 34px;
    font-weight: 900;
    line-height: 0.8;
    color: #111;
  }
  .cwo-since{
    font-size: 10px;
    letter-spacing: 2px;
    color: #444;
    margin-left: 2px;
  }
  .cwo-logo-text{
    display:flex;
    flex-direction:column;
  }

  .cwo-others-label{
    text-align:right;
    padding-right: 10px;
    font-size: clamp(20px, 2.5vw, 30px);
    font-weight: 800;
    color: #111;
    text-transform: uppercase;
  }

  /* ---------- Center split visual ---------- */
  /* Both source images should share the same canvas size, each transparent
     on the half they don't use, so stacking them lines the seam up exactly. */
  .cwo-split-visual{
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    aspect-ratio: 1080 / 1350;
    background: #ffffff;
  }

  .cwo-split-visual img{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .cwo-split-visual-placeholder{
    position: absolute;
    inset: 0;
  }
  .cwo-split-visual-placeholder .cwo-placeholder-svg{
    width: 100%;
    height: 100%;
  }

  /* ---------- Comparison rows ---------- */
  .cwo-rows{
    display:grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 10px;
  }

  .cwo-rows .cwo-col{
    display:flex;
    flex-direction:column;
  }

  .cwo-rows .cwo-dark{
    background: var(--cwo-dark);
    color: var(--cwo-dark-text);
  }
  .cwo-rows .cwo-light{
    background: var(--cwo-light-bg);
    color: var(--cwo-light-text);
  }

  .cwo-rows .cwo-row{
    padding: 26px 28px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    line-height: 1.4;
    border-bottom: 1px solid var(--cwo-line-on-dark);
  }
  .cwo-rows .cwo-light .cwo-row{
    border-bottom: 1px solid var(--cwo-line);
    text-align: right;
  }
  .cwo-rows .cwo-dark .cwo-row:last-child,
  .cwo-rows .cwo-light .cwo-row:last-child{
    border-bottom: none;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 749px){
    .cwo-section{ padding: 40px 16px 40px; }
    .cwo-others-label{ font-size: 20px; }
    .cwo-mark .cwo-big-d{ font-size: 24px; }
    .cwo-rows .cwo-row{
      padding: 18px 16px;
      font-size: 12.5px;
    }
    .cwo-split-visual{ max-width: 300px; }
  }
</style>

{% schema %}
{
  "name": "Comparing With Others",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparing With Others?"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Left brand mark"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional)",
      "info": "If set, this replaces the text logo below."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (used if no logo image)",
      "default": "iD"
    },
    {
      "type": "text",
      "id": "logo_subtext",
      "label": "Logo subtext",
      "default": "SINCE 1969"
    },
    {
      "type": "header",
      "content": "Right label"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Right-side label",
      "default": "Others"
    },
    {
      "type": "header",
      "content": "Split comparison image"
    },
    {
      "type": "paragraph",
      "content": "Upload two images exported on the same canvas size, each showing only its half (transparent on the other half) so the seam lines up automatically."
    },
    {
      "type": "image_picker",
      "id": "leather_image",
      "label": "Left half image (e.g. product photo)"
    },
    {
      "type": "image_picker",
      "id": "outline_image",
      "label": "Right half image (e.g. outline artwork)"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "left_text",
          "label": "Left side text",
          "default": "Genuine Leather & High Quality Materials"
        },
        {
          "type": "text",
          "id": "right_text",
          "label": "Right side text",
          "default": "Synthetic or Blended Materials"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparing With Others",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "Genuine Leather & High Quality Materials",
            "right_text": "Synthetic or Blended Materials"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "Anti Bacterial Coating – NODR",
            "right_text": "No Odour or Hygiene Treatment"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "56 Air Pocket Soles, Ultra HD Bounce Back Cushion",
            "right_text": "Basic Foam Insole"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "Original Indian Design Language",
            "right_text": "Generic Silhouettes"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "left_text": "Return / Exchange Support",
            "right_text": "Rigid Return Policies"
          }
        }
      ]
    }
  ]
}
{% endschema %}
