{% comment %}
  ============================================================
  COMPARING WITH OTHERS
  ============================================================
{% endcomment %}

<section
  id="comparison-{{ section.id }}"
  class="comparison-section"
>
  <!-- ========================================================
       HEADING
       ======================================================== -->

  {% if section.settings.heading != blank %}
    <div class="comparison-heading">
      {{ section.settings.heading }}
    </div>
  {% endif %}


  <!-- ========================================================
       TOP BRAND / OTHERS
       ======================================================== -->

  <div class="comparison-header">

    <div class="comparison-header-side comparison-header-left">

      {% if section.settings.brand_logo != blank %}

        <div class="comparison-logo">
          {{
            section.settings.brand_logo
            | image_url: width: 500
            | image_tag:
              loading: 'lazy',
              widths: '150, 250, 350, 500',
              class: 'comparison-logo-image'
          }}
        </div>

      {% endif %}

    </div>


    <div class="comparison-header-side comparison-header-right">

      {% if section.settings.others_heading != blank %}
        <div class="comparison-others">
          {{ section.settings.others_heading }}
        </div>
      {% endif %}

    </div>

  </div>


  <!-- ========================================================
       COMPARISON TABLE
       ======================================================== -->

  <div class="comparison-table">

    <!-- LEFT BACKGROUND -->

    <div class="comparison-side comparison-side-left">
    </div>


    <!-- RIGHT BACKGROUND -->

    <div class="comparison-side comparison-side-right">
    </div>


    <!-- ======================================================
         ROWS
         ====================================================== -->

    <div class="comparison-content">

      {% for block in section.blocks %}

        <div
          class="comparison-row"
          {{ block.shopify_attributes }}
        >

          <!-- LEFT -->

          <div class="comparison-column comparison-column-left">

            {% if block.settings.left_text != blank %}

              <div class="comparison-text">
                {{ block.settings.left_text | newline_to_br }}
              </div>

            {% endif %}

          </div>


          <!-- RIGHT -->

          <div class="comparison-column comparison-column-right">

            {% if block.settings.right_text != blank %}

              <div class="comparison-text">
                {{ block.settings.right_text | newline_to_br }}
              </div>

            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>


    <!-- ======================================================
         CENTER SHOE
         ====================================================== -->

    {% if section.settings.real_shoe != blank or section.settings.outline_shoe != blank %}

      <div
        class="comparison-shoe"
        style="
          --shoe-width: {{ section.settings.image_width }}px;
        "
      >

        <!-- REAL / LEATHER SHOE -->

        {% if section.settings.real_shoe != blank %}

          <div class="comparison-shoe-half comparison-shoe-left">

            {{
              section.settings.real_shoe
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1500, 1800',
                class: 'comparison-shoe-img'
            }}

          </div>

        {% endif %}


        <!-- OUTLINE SHOE -->

        {% if section.settings.outline_shoe != blank %}

          <div class="comparison-shoe-half comparison-shoe-right">

            {{
              section.settings.outline_shoe
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1500, 1800',
                class: 'comparison-shoe-img'
            }}

          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>


<style>

/* ============================================================
   SECTION
   ============================================================ */

#comparison-{{ section.id }} {

  width: 100%;

  display: block;

  position: relative;

  margin: 0;

  padding: 0;

  background: #ffffff;

  box-sizing: border-box;

  overflow: hidden;
}


/* ============================================================
   HEADING
   ============================================================ */

#comparison-{{ section.id }} .comparison-heading {

  width: 100%;

  padding: 70px 20px 35px;

  box-sizing: border-box;

  text-align: center;

  font-size: {{ section.settings.heading_size }}px;

  line-height: 0.95;

  font-weight: 800;

  letter-spacing: -1.5px;

  color: #000000;

  text-transform: uppercase;
}


/* ============================================================
   HEADER
   ============================================================ */

#comparison-{{ section.id }} .comparison-header {

  width: 100%;

  display: grid;

  grid-template-columns: 1fr 1fr;

  height: 150px;

  box-sizing: border-box;

  position: relative;

  z-index: 5;
}


#comparison-{{ section.id }} .comparison-header-side {

  display: flex;

  align-items: center;

  box-sizing: border-box;
}


#comparison-{{ section.id }} .comparison-header-left {

  justify-content: center;

  padding-right: 160px;
}


#comparison-{{ section.id }} .comparison-header-right {

  justify-content: center;

  padding-left: 160px;
}


/* ============================================================
   LOGO
   ============================================================ */

#comparison-{{ section.id }} .comparison-logo {

  width: 150px;

  max-width: 150px;
}


#comparison-{{ section.id }} .comparison-logo-image {

  display: block;

  width: 100%;

  height: auto;
}


/* ============================================================
   OTHERS
   ============================================================ */

#comparison-{{ section.id }} .comparison-others {

  font-size: 32px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: -0.5px;

  text-transform: uppercase;

  color: #000000;

  white-space: nowrap;
}


/* ============================================================
   TABLE
   ============================================================ */

#comparison-{{ section.id }} .comparison-table {

  width: 100%;

  position: relative;

  box-sizing: border-box;

  overflow: hidden;

  margin-top: 35px;

  margin-bottom: 35px;
}


/* ============================================================
   LEFT / RIGHT BACKGROUNDS
   ============================================================ */

#comparison-{{ section.id }} .comparison-side {

  position: absolute;

  top: 0;

  bottom: 0;

  width: 50%;

  z-index: 0;

  pointer-events: none;
}


#comparison-{{ section.id }} .comparison-side-left {

  left: 0;

  background: {{ section.settings.left_background }};
}


#comparison-{{ section.id }} .comparison-side-right {

  right: 0;

  background: {{ section.settings.right_background }};
}


/* ============================================================
   CONTENT
   ============================================================ */

#comparison-{{ section.id }} .comparison-content {

  width: 100%;

  position: relative;

  z-index: 2;
}


/* ============================================================
   ROW
   ============================================================ */

#comparison-{{ section.id }} .comparison-row {

  width: 100%;

  min-height: {{ section.settings.row_height }}px;

  display: grid;

  grid-template-columns: 1fr 1fr;

  box-sizing: border-box;

  border-bottom: 1px solid rgba(0, 0, 0, 0.65);
}


/* ============================================================
   COLUMNS
   ============================================================ */

#comparison-{{ section.id }} .comparison-column {

  min-height: {{ section.settings.row_height }}px;

  display: flex;

  align-items: center;

  box-sizing: border-box;

  position: relative;
}


#comparison-{{ section.id }} .comparison-column-left {

  justify-content: flex-start;

  padding: 25px 70px 25px 40px;
}


#comparison-{{ section.id }} .comparison-column-right {

  justify-content: flex-end;

  padding: 25px 40px 25px 70px;

  text-align: right;
}


/* ============================================================
   TEXT
   ============================================================ */

#comparison-{{ section.id }} .comparison-text {

  width: 100%;

  font-size: 20px;

  line-height: 1.55;

  font-weight: 700;

  letter-spacing: 0;

  text-transform: uppercase;

  position: relative;

  z-index: 3;
}


#comparison-{{ section.id }} .comparison-column-left .comparison-text {

  color: {{ section.settings.left_text_color }};

  text-align: left;
}


#comparison-{{ section.id }} .comparison-column-right .comparison-text {

  color: {{ section.settings.right_text_color }};

  text-align: right;
}


/* ============================================================
   CENTER SHOE
   ============================================================ */

/*
  The shoe is anchored to the complete height of the
  comparison table.

  This allows the shoe to remain centered regardless of:
  - number of rows
  - row height
  - desktop/mobile screen size
*/

#comparison-{{ section.id }} .comparison-shoe {

  position: absolute;

  left: 50%;

  top: 0;

  bottom: 0;

  width: var(--shoe-width);

  transform: translateX(-50%);

  z-index: 10;

  pointer-events: none;
}


/* ============================================================
   SHOE HALF
   ============================================================ */

#comparison-{{ section.id }} .comparison-shoe-half {

  position: absolute;

  top: 0;

  left: 0;

  width: 100%;

  height: 100%;

  overflow: hidden;
}


/* ============================================================
   SHOE IMAGE
   ============================================================ */

#comparison-{{ section.id }} .comparison-shoe-img {

  position: absolute;

  top: 0;

  left: 0;

  width: 100% !important;

  height: 100% !important;

  max-width: none !important;

  display: block;

  object-fit: contain;

  object-position: center center;
}


/* ============================================================
   REAL SHOE = LEFT HALF
   ============================================================ */

#comparison-{{ section.id }} .comparison-shoe-left {

  clip-path: inset(0 50% 0 0);
}


/* ============================================================
   OUTLINE = RIGHT HALF
   ============================================================ */

#comparison-{{ section.id }} .comparison-shoe-right {

  clip-path: inset(0 0 0 50%);
}


/* ============================================================
   CENTER LINE
   ============================================================ */

#comparison-{{ section.id }} .comparison-shoe::after {

  content: "";

  position: absolute;

  top: 0;

  bottom: 0;

  left: 50%;

  width: 1px;

  transform: translateX(-50%);

  background: transparent;
}


/* ============================================================
   TABLET
   ============================================================ */

@media screen and (max-width: 990px) {

  #comparison-{{ section.id }} .comparison-heading {

    font-size: 55px;

    padding-top: 55px;
  }


  #comparison-{{ section.id }} .comparison-header-left {

    padding-right: 100px;
  }


  #comparison-{{ section.id }} .comparison-header-right {

    padding-left: 100px;
  }


  #comparison-{{ section.id }} .comparison-text {

    font-size: 17px;
  }


  #comparison-{{ section.id }} .comparison-column-left {

    padding-left: 25px;

    padding-right: 55px;
  }


  #comparison-{{ section.id }} .comparison-column-right {

    padding-left: 55px;

    padding-right: 25px;
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media screen and (max-width: 749px) {

  #comparison-{{ section.id }} .comparison-heading {

    padding: 45px 15px 25px;

    font-size: {{ section.settings.heading_mobile_size }}px;

    letter-spacing: -0.8px;
  }


  #comparison-{{ section.id }} .comparison-header {

    height: 100px;
  }


  #comparison-{{ section.id }} .comparison-header-left {

    padding-right: 45px;
  }


  #comparison-{{ section.id }} .comparison-header-right {

    padding-left: 45px;
  }


  #comparison-{{ section.id }} .comparison-logo {

    width: 90px;

    max-width: 90px;
  }


  #comparison-{{ section.id }} .comparison-others {

    font-size: 19px;
  }


  /* ----------------------------------------------------------
     MOBILE ROWS
     ---------------------------------------------------------- */

  #comparison-{{ section.id }} .comparison-row {

    min-height: 80px;
  }


  #comparison-{{ section.id }} .comparison-column {

    min-height: 80px;
  }


  #comparison-{{ section.id }} .comparison-column-left {

    padding: 14px 35px 14px 15px;
  }


  #comparison-{{ section.id }} .comparison-column-right {

    padding: 14px 15px 14px 35px;
  }


  #comparison-{{ section.id }} .comparison-text {

    font-size: 11px;

    line-height: 1.4;
  }


  /* ----------------------------------------------------------
     MOBILE SHOE
     ---------------------------------------------------------- */

  /*
    IMPORTANT:

    The previous mobile width was only 190px.
    That made the shoe look too small compared with
    the overall comparison table.

    300px gives the shoe considerably more visual
    presence while keeping its center exactly on
    the dividing line.
  */

  #comparison-{{ section.id }} .comparison-shoe {

    width: 300px;

    left: 50%;

    transform: translateX(-50%);

    top: 0;

    bottom: 0;

    z-index: 10;
  }


  #comparison-{{ section.id }} .comparison-shoe-half {

    top: 0;

    bottom: 0;

    height: 100%;
  }


  #comparison-{{ section.id }} .comparison-shoe-img {

    width: 100% !important;

    height: 100% !important;

    max-width: none !important;

    display: block;

    /*
      Cover makes the shoe visually larger.
      The center clipping ensures only the
      required half remains visible.
    */

    object-fit: cover !important;

    object-position: center center;
  }

}


/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media screen and (max-width: 480px) {

  #comparison-{{ section.id }} .comparison-heading {

    font-size: 34px;
  }


  #comparison-{{ section.id }} .comparison-header {

    height: 85px;
  }


  #comparison-{{ section.id }} .comparison-header-left {

    padding-right: 30px;
  }


  #comparison-{{ section.id }} .comparison-header-right {

    padding-left: 30px;
  }


  #comparison-{{ section.id }} .comparison-logo {

    width: 75px;

    max-width: 75px;
  }


  #comparison-{{ section.id }} .comparison-others {

    font-size: 16px;
  }


  /* ----------------------------------------------------------
     SMALL MOBILE ROWS
     ---------------------------------------------------------- */

  #comparison-{{ section.id }} .comparison-row {

    min-height: 68px;
  }


  #comparison-{{ section.id }} .comparison-column {

    min-height: 68px;
  }


  #comparison-{{ section.id }} .comparison-column-left {

    padding: 10px 25px 10px 12px;
  }


  #comparison-{{ section.id }} .comparison-column-right {

    padding: 10px 12px 10px 25px;
  }


  #comparison-{{ section.id }} .comparison-text {

    font-size: 9px;

    line-height: 1.35;
  }


  /* ----------------------------------------------------------
     SMALL MOBILE SHOE
     ---------------------------------------------------------- */

  /*
    Increased from 160px to 260px.

    This is the main fix for the screenshot you sent.
  */

  #comparison-{{ section.id }} .comparison-shoe {

    width: 260px;

    left: 50%;

    transform: translateX(-50%);

    top: 0;

    bottom: 0;

    z-index: 10;
  }


  #comparison-{{ section.id }} .comparison-shoe-half {

    top: 0;

    bottom: 0;

    height: 100%;

    overflow: hidden;
  }


  #comparison-{{ section.id }} .comparison-shoe-img {

    width: 100% !important;

    height: 100% !important;

    max-width: none !important;

    display: block;

    object-fit: cover !important;

    object-position: center center;
  }

}


/* ============================================================
   VERY SMALL PHONES
   ============================================================ */

@media screen and (max-width: 360px) {

  #comparison-{{ section.id }} .comparison-shoe {

    width: 235px;
  }


  #comparison-{{ section.id }} .comparison-column-left {

    padding-right: 22px;
  }


  #comparison-{{ section.id }} .comparison-column-right {

    padding-left: 22px;
  }


  #comparison-{{ section.id }} .comparison-text {

    font-size: 8.5px;

    line-height: 1.3;
  }

}

</style>


{% schema %}

