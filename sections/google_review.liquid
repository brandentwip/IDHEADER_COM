<section
  class="google-review-grid desktop-cols-{{ section.settings.desktop_columns }} mobile-cols-{{ section.settings.mobile_columns }}"
>

  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="review-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="review-grid">

      {% for block in section.blocks %}

        <div
          class="review-card"
          {{ block.shopify_attributes }}
        >

          <div class="review-rating">

            {{ block.settings.rating }}

          </div>

          <div class="review-stars">

            {% assign full = block.settings.rating | floor %}
            {% assign decimal = block.settings.rating | modulo: 1 %}

            {% for i in (1..5) %}

              {% if i <= full %}
                ★
              {% elsif decimal >= 0.5 %}
                ⯨
                {% assign decimal = 0 %}
              {% else %}
                ☆
              {% endif %}

            {% endfor %}

          </div>

          <div class="review-platform">

            {% if block.settings.platform == 'google' %}

              <span>Reviews on</span>

              <img
                src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg"
                alt="Google"
                loading="lazy"
              >

            {% elsif block.settings.platform == 'trustpilot' %}

              <span>Reviews on</span>

              <strong>Trustpilot</strong>

            {% elsif block.settings.platform == 'judgeme' %}

              <span>Reviews on</span>

              <strong>Judge.me</strong>

            {% else %}

              {{ block.settings.custom_platform }}

            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

    {% if section.settings.button_label != blank %}

      <div class="review-footer">

        <a
          href="{{ section.settings.button_link }}"
          class="review-button"
        >
          {{ section.settings.button_label }}
        </a>

      </div>

    {% endif %}

  </div>

</section>



<style>

/*==========================================
  GOOGLE REVIEW GRID
===========================================*/

.google-review-grid{
    padding:90px 0;
    background:#fff;
}

.google-review-grid .page-width{
    max-width:1400px;
    margin:0 auto;
    padding:0 40px;
}

/*==========================================
  HEADING
===========================================*/

.review-heading{
    margin:0 0 70px;
    font-size:48px;
    font-weight:500;
    line-height:1.1;
    color:#111;
    letter-spacing:-0.03em;
}

/*==========================================
  GRID
===========================================*/

.review-grid{
    display:grid;
    gap:80px;
}

.desktop-cols-1 .review-grid{
    grid-template-columns:1fr;
}

.desktop-cols-2 .review-grid{
    grid-template-columns:repeat(2,1fr);
}

.desktop-cols-3 .review-grid{
    grid-template-columns:repeat(3,1fr);
}

.desktop-cols-4 .review-grid{
    grid-template-columns:repeat(4,1fr);
}

/*==========================================
  CARD
===========================================*/

.review-card{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
}

.review-rating{
    font-size:72px;
    font-weight:400;
    line-height:1;
    color:#111;
}

.review-stars{
    margin:22px 0;
    font-size:24px;
    color:#F4B400;
    letter-spacing:3px;
}

.review-platform{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    font-size:24px;
    color:#111;
}

.review-platform span{
    font-size:18px;
    color:#111;
}

.review-platform img{
    height:28px;
    width:auto;
    display:block;
}

.review-platform strong{
    font-weight:500;
    font-size:22px;
}

/*==========================================
  BUTTON
===========================================*/

.review-footer{
    margin-top:70px;
}

.review-button{
    display:inline-block;
    color:#111;
    text-decoration:none;
    font-size:14px;
    text-transform:uppercase;
    letter-spacing:.18em;
    border-bottom:1px solid #111;
    padding-bottom:5px;
    transition:.3s;
}

.review-button:hover{
    opacity:.6;
}

/*==========================================
  MOBILE
===========================================*/

@media screen and (max-width:990px){

.google-review-grid{
    padding:60px 0;
}

.google-review-grid .page-width{
    padding:0 20px;
}

.review-heading{
    font-size:34px;
    margin-bottom:40px;
}

.mobile-cols-1 .review-grid{
    grid-template-columns:1fr;
}

.mobile-cols-2 .review-grid{
    grid-template-columns:repeat(2,1fr);
}

.review-grid{
    gap:35px 25px;
}

.review-rating{
    font-size:50px;
}

.review-stars{
    font-size:18px;
    margin:14px 0;
}

.review-platform{
    gap:6px;
}

.review-platform span{
    font-size:15px;
}

.review-platform img{
    height:20px;
}

.review-platform strong{
    font-size:16px;
}

.review-footer{
    margin-top:45px;
}

.review-button{
    font-size:12px;
}

}

</style>




