            {
              "value": "4.6",
              "label": "4.6"
            },
            {
              "value": "4.5",
              "label": "4.5"
            },
            {
              "value": "4.4",
              "label": "4.4"
            },
            {
              "value": "4.3",
              "label": "4.3"
            },
            {
              "value": "4.2",
              "label": "4.2"
            },
            {
              "value": "4.1",
              "label": "4.1"
            },
            {
              "value": "4.0",
              "label": "4.0"
