<section class="featured-collection-section">
  {% if section.settings.heading != blank %}
    <h2 class="featured-collection-title">{{ section.settings.heading }}</h2>
  {% endif %}

  <!-- Filters -->
  <div class="collection-filters">
    <form id="collection-filters-form">
      <div class="filter-group">
        <label for="filter-vendor">Vendor</label>
        <select id="filter-vendor" name="vendor">
          <option value="">All</option>
          {% for vendor in shop.vendors %}
            <option value="{{ vendor | escape }}">{{ vendor }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-type">Product Type</label>
        <select id="filter-type" name="type">
          <option value="">All</option>
          {% for type in shop.types %}
            <option value="{{ type | escape }}">{{ type }}</option>
          {% endfor %}
        </select>
      </div>

      <button type="submit" class="btn-filter">Apply</button>
    </form>
  </div>

  <!-- Product grid -->
  <div class="collection-grid">
    {% paginate collections[section.settings.collection].products by section.settings.products_per_page %}
      {% for product in collections[section.settings.collection].products %}
        <div class="collection-card">
          <a href="{{ product.url }}">
            <div class="image-wrap">
              <img src="{{ product.featured_image | img_url: '540x' }}" alt="{{ product.title | escape }}">
            </div>
            <h3 class="product-title">{{ product.title }}</h3>
            <p class="product-price">{{ product.price | money }}</p>
            
          </a>
        </div>
      {% endfor %}

      <!-- Pagination (used by script for next-page URL) -->
      {% if paginate.pages > 1 %}
        <div class="pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="prev">Previous</a>
          {% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="next">Next</a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>

  <!-- Loading Spinner -->
  <div class="infinite-spinner" style="display:none;">
    <div class="spinner" role="status" aria-hidden="true"></div>
  </div>

  <!-- Sentinel observed by IntersectionObserver -->
  <div class="infinite-sentinel" aria-hidden="true"></div>
</section>

<style>
.featured-collection-section {
  padding: 40px 20px;
}
.featured-collection-title {
  text-align: center;
  font-size: 28px;
  margin-bottom: 20px;
}
.collection-filters {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 25px;
  flex-wrap: wrap;
}
.collection-filters .filter-group {
  display: flex;
  flex-direction: column;
}
.collection-filters label {
  font-size: 14px;
  margin-bottom: 5px;
}
.collection-filters select {
  padding: 6px;
  font-size: 14px;
}
.btn-filter {
  padding: 8px 16px;
  background: black;
  color: white;
  border: none;
  cursor: pointer;
  font-size: 14px;
}
.collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
}
.collection-card {
  text-align: center;
}
.collection-card img {
  width: 100%;
  height: auto;
  display: block;
}
.pagination {
  text-align: center;
  margin-top: 30px;
}
.pagination a {
  margin: 0 10px;
  text-decoration: none;
  color: black;
}

/* Spinner Styles */
.infinite-spinner {
  text-align: center;
  margin: 30px 0;
}
.spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #ccc;
  border-top-color: black;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  display: inline-block;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Sentinel (invisible) */
.infinite-sentinel {
  height: 1px;
  width: 100%;
  display: block;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const grid = document.querySelector('.collection-grid');
  const spinner = document.querySelector('.infinite-spinner');
  const pagination = document.querySelector('.pagination');
  const sentinel = document.querySelector('.infinite-sentinel');

  if (!grid) {
    console.warn('[Infinite Scroll] .collection-grid not found.');
    return;
  }

  // Try to find the next page URL from the pagination section
  let nextPageUrl = pagination?.querySelector('a.next')?.href || null;
  let loading = false;

  // If there's no next page to start with, hide pagination and skip setup
  if (!nextPageUrl) {
    if (pagination) pagination.style.display = 'none';
    return;
  }

  // Hide original pagination visually (but keep in DOM because we use its links)
  if (pagination) pagination.style.display = 'none';

  // IntersectionObserver to trigger load when sentinel is near viewport
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !loading) {
        loadNextPage();
      }
    });
  }, { root: null, rootMargin: '400px', threshold: 0.01 });

  observer.observe(sentinel);

  function loadNextPage() {
    if (!nextPageUrl) {
      observer.disconnect();
      return;
    }
    loading = true;
    spinner.style.display = 'block';
    console.debug('[Infinite Scroll] Loading:', nextPageUrl);

    fetch(nextPageUrl, { credentials: 'same-origin' })
      .then(resp => {
        if (!resp.ok) throw new Error('Network response was not ok: ' + resp.status);
        return resp.text();
      })
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // Preferred: get `.collection-card` elements in the fetched document
        let newCards = doc.querySelectorAll('.collection-card');

        // Fallback: if no .collection-card found, try to find .collection-grid in the response
        if ((!newCards || newCards.length === 0) && doc.querySelector('.collection-grid')) {
          const newGrid = doc.querySelector('.collection-grid');
          newCards = newGrid ? newGrid.children : [];
        }

        if (!newCards || newCards.length === 0) {
          console.warn('[Infinite Scroll] No product cards found on fetched page. Stopping.');
          nextPageUrl = null;
          observer.disconnect();
          if (pagination) pagination.remove();
          spinner.style.display = 'none';
          loading = false;
          return;
        }

        // Append cloned nodes into current grid
        Array.from(newCards).forEach(card => {
          const clone = card.cloneNode(true);
          grid.appendChild(clone);
        });

        // Update nextPageUrl from fetched page's pagination
        const nextLink = doc.querySelector('.pagination a.next');
        nextPageUrl = nextLink ? nextLink.href : null;

        if (!nextPageUrl) {
          // No more pages
          console.debug('[Infinite Scroll] No more pages.');
          if (pagination) pagination.remove();
          observer.disconnect();
        } else {
          console.debug('[Infinite Scroll] Next page set to:', nextPageUrl);
        }

        spinner.style.display = 'none';
        loading = false;
      })
      .catch(err => {
        console.error('[Infinite Scroll] Fetch error:', err);
        // Keep observer alive so it can retry later
        spinner.style.display = 'none';
        loading = false;
      });
  }
});
</script>

{% schema %}
{
  "name": "Custom Collection Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid"
    }
  ]
}
{% endschema %}
