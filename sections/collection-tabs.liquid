<section
  id="collection-tabs-{{ section.id }}"
  class="collection-tabs"
  style="
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="collection-tabs__header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <!-- Tabs -->
    <div class="collection-tabs__nav">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        {% if collection != blank %}
          <button
            class="collection-tab {% if forloop.first %}active{% endif %}"
            data-tab="{{ collection.handle }}"
            data-url="{{ collection.url }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.label != blank %}
              {{ block.settings.label }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </button>

          {% unless forloop.last %}
            <span class="collection-divider">/</span>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>

    <!-- Collection Panels -->

    <div class="collection-tabs__panels">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        {% if collection != blank %}
          <div
            class="collection-panel {% if forloop.first %}active{% endif %}"
            data-panel="{{ collection.handle }}"
          >
            <div
              class="collection-grid columns-{{ section.settings.desktop_columns }}"
            >
              {% for product in collection.products limit: section.settings.products_to_show %}
                <article class="collection-card">
                  <a
                    href="{{ product.url }}"
                    class="collection-card__image"
                  >
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag: loading: 'lazy', widths: '450,700,900'
                    }}
                  </a>

                  <div class="collection-card__content">
                    <h3>
                      <a href="{{ product.url }}">
                        {{ product.title }}
                      </a>
                    </h3>

                    <div class="collection-card__price">
                      {% if product.compare_at_price > product.price %}
                        <span class="sale">
                          {{ product.price | money }}
                        </span>

                        {% if section.settings.show_compare_price %}
                          <span class="compare">
                            {{ product.compare_at_price | money }}
                          </span>
                        {% endif %}

                      {% else %}
                        <span class="regular">
                          {{ product.price | money }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign first_collection = section.blocks.first.settings.collection %}

    {% if section.settings.show_button and first_collection != blank %}
      <div class="collection-tabs__footer">
        <a
          href="{{ first_collection.url }}"
          class="collection-tabs__button"
          id="collection-button-{{ section.id }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>
  <style>
    #collection-tabs-{{ section.id }}{

    --heading-size:48px;
    --text:#111111;

    }

    #collection-tabs-{{ section.id }} .page-width{

    max-width:1440px;
    margin:auto;
    padding:0 40px;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__header{

    margin-bottom:18px;

    }

    #collection-tabs-{{ section.id }} h2{

    margin:0;

    font-size: 36.75px;

    font-weight:500;

    line-height:1.1;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__nav{

    display:flex;

    align-items:center;

    flex-wrap:wrap;

    gap:10px;

    margin-bottom:45px;

    }

    #collection-tabs-{{ section.id }} .collection-divider{

    opacity:.4;

    font-size:14px;

    }

    #collection-tabs-{{ section.id }} .collection-tab{

    background:none;

    border:none;

    padding:0;

    cursor:pointer;

    text-transform:uppercase;

    letter-spacing:.15em;

    font-size:10px;

    position:relative;

    }

    #collection-tabs-{{ section.id }} .collection-tab::after{

    content:"";

    position:absolute;

    left:0;

    bottom:-8px;

    width:0;

    height:2px;

    background:#111;

    transition:.3s;

    }

    #collection-tabs-{{ section.id }} .collection-tab.active::after{

    width:100%;

    }

    #collection-tabs-{{ section.id }} .collection-panel{

    display:none;

    animation:fade .35s ease;

    }

    #collection-tabs-{{ section.id }} .collection-panel.active{

    display:block;

    }

    #collection-tabs-{{ section.id }} .collection-grid{

    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;

    }

    #collection-tabs-{{ section.id }} .collection-card{

    display:flex;

    flex-direction:column;

    }

    #collection-tabs-{{ section.id }} .collection-card__image{

    display:block;

    overflow:hidden;

    background:#f5f5f5;

    }

    #collection-tabs-{{ section.id }} .collection-card__image img{

    display:block;

    width:100%;

    transition:.45s;

    }

    #collection-tabs-{{ section.id }} .collection-card:hover img{

    transform:scale(1.05);

    }

    #collection-tabs-{{ section.id }} .collection-card__content{

    padding-top:18px;

    }

    #collection-tabs-{{ section.id }} .collection-card__content h3{

    font-size:15px;

    font-weight:400;

    line-height:1.5;

    margin:0 0 10px;

    }

    #collection-tabs-{{ section.id }} .collection-card__content a{

    text-decoration:none;

    color:inherit;

    }

    #collection-tabs-{{ section.id }} .collection-card__price{

    display:flex;

    gap:10px;

    align-items:center;

    }

    #collection-tabs-{{ section.id }} .compare{

    text-decoration:line-through;

    opacity:.5;

    }

    /* ===========================
       Product Cards
    =========================== */

    #collection-tabs-{{ section.id }} .sale{
        font-weight:600;
        color:#111;
    }

    #collection-tabs-{{ section.id }} .regular{
        font-weight:600;
        color:#111;
    }

    #collection-tabs-{{ section.id }} .compare{
        color:#8d8d8d;
        font-size:14px;
    }

    #collection-tabs-{{ section.id }} .collection-card__image{
        position:relative;
        aspect-ratio: 4 / 5;
    }

    #collection-tabs-{{ section.id }} .collection-card__image img{
        width:100%;
        height:100%;
        object-fit:cover;
    }

    /* ===========================
       Button
    =========================== */

    #collection-tabs-{{ section.id }} .collection-tabs__footer{
        margin-top:55px;
        text-align:center;
    }

    #collection-tabs-{{ section.id }} .collection-tabs__button{

        display:inline-flex;
        align-items:center;
        justify-content:center;

        padding:16px 42px;

        background:#111;
        color:#fff;

        text-decoration:none;

        text-transform:uppercase;

        letter-spacing:.12em;

        font-size:13px;

        transition:.3s ease;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__button:hover{

        background:#2d2d2d;

    }

    /* ===========================
       Hover
    =========================== */

    #collection-tabs-{{ section.id }} .collection-card{

        transition:.35s ease;

    }

    #collection-tabs-{{ section.id }} .collection-card:hover{

        transform:translateY(-4px);

    }

    #collection-tabs-{{ section.id }} .collection-tab{

        transition:.3s;

    }

    #collection-tabs-{{ section.id }} .collection-tab:hover{

        opacity:.7;

    }

    /* ===========================
       Fade
    =========================== */

    @keyframes fade{

    0%{
    opacity:0;
    transform:translateY(12px);
    }

    100%{
    opacity:1;
    transform:translateY(0);
    }

    }

    /* ===========================
       Tablet
    =========================== */

    @media (max-width:990px){

    #collection-tabs-{{ section.id }} .page-width{

    padding:0 24px;

    }

    #collection-tabs-{{ section.id }}{

    --heading-size:38px;

    }

    #collection-tabs-{{ section.id }} .collection-grid{

    grid-template-columns:repeat(2,1fr);

    gap:20px;

}




    }



    /* ===========================
       Mobile
    =========================== */

    @media (max-width:749px){

    #collection-tabs-{{ section.id }}{

    --heading-size:30px;

    }



    #collection-tabs-{{ section.id }} .page-width{

    padding:0 18px;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__header{

    margin-bottom:14px;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__nav{

    overflow-x:auto;
    overflow-y:hidden;

    flex-wrap:nowrap;

    white-space:nowrap;

    padding-bottom:10px;

    gap:8px;

    scrollbar-width:none;

    -webkit-overflow-scrolling:touch;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__nav::-webkit-scrollbar{

    display:none;

    }

    #collection-tabs-{{ section.id }} .collection-tab{

    flex-shrink:0;

    font-size:11px;

    }

    #collection-tabs-{{ section.id }} .collection-divider{

    flex-shrink:0;

    }

    #collection-tabs-{{ section.id }} .collection-grid{

    grid-template-columns:repeat(2,1fr);

    gap:14px;

    }

    #collection-tabs-{{ section.id }} .collection-card__content{

    padding-top:12px;

    }

    #collection-tabs-{{ section.id }} .collection-card__content h3{

    font-size:13px;

    line-height:1.4;

    }

    #collection-tabs-{{ section.id }} .collection-card__price{

    font-size:13px;

    gap:8px;

    }

    #collection-tabs-{{ section.id }} .collection-tabs__button{

    width:100%;

    padding:15px 20px;

    }

    }

    /* ===========================
       Large Desktop
    =========================== */

    @media (min-width:1600px){

    #collection-tabs-{{ section.id }} .page-width{

    max-width:1600px;

    }

    #collection-tabs-{{ section.id }}{

    --heading-size:56px;

    }

    #collection-tabs-{{ section.id }} .collection-grid{

    gap:36px;

    }

    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const section = document.getElementById('collection-tabs-{{ section.id }}');
      if (!section) return;

      const tabs = section.querySelectorAll('.collection-tab');
      const panels = section.querySelectorAll('.collection-panel');
      const button = section.querySelector('#collection-button-{{ section.id }}');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          // Prevent unnecessary work
          if (tab.classList.contains('active')) return;

          const handle = tab.dataset.tab;
          const url = tab.dataset.url;

          // Active Tab
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          // Active Panel
          panels.forEach((panel) => {
            if (panel.dataset.panel === handle) {
              panel.classList.add('active');
            } else {
              panel.classList.remove('active');
            }
          });

          // Update button
          if (button) {
            button.href = url;
          }
        });
      });
    });
  </script>

  {% schema %}
{
  "name": "Collection Tabs",
  "tag": "section",
  "class": "collection-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Launch"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 2,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Desktop Columns"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ]
    },


    




    {
      "type": "checkbox",
      "id": "show_compare_price",
      "default": true,
      "label": "Show compare at price"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "Show button"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "SHOW ALL PRODUCTS",
      "label": "Button Label"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label (optional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
  {% endschema %}
