<section
  class="brand-story-section"
  id="brand-story-{{ section.id }}"
  style="
    background:{{ section.settings.bg_color }};
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
  "
>

<div class="page-width">

<div class="brand-story">

<div class="brand-story__content">

{% if section.settings.logo != blank %}
<div class="brand-story__logo">
{{
section.settings.logo
| image_url: width:200
| image_tag:
loading:'lazy'
}}
</div>
{% endif %}

{% if section.settings.small_heading != blank %}
<div class="brand-story__eyebrow">
{{ section.settings.small_heading }}
</div>
{% endif %}

{% if section.settings.heading != blank %}
<h2 class="brand-story__heading">
{{ section.settings.heading }}
</h2>
{% endif %}

{% if section.settings.description != blank %}
<div class="brand-story__description">
{{ section.settings.description }}
</div>
{% endif %}

{% if section.settings.button_label != blank %}
<a
href="{{ section.settings.button_link }}"
class="brand-story__button"
>
{{ section.settings.button_label }}
</a>
{% endif %}

</div>

<div class="brand-story__categories">

{% for block in section.blocks %}

<a
class="brand-category"
href="{{ block.settings.link }}"
{{ block.shopify_attributes }}
>

<div class="brand-category__circle">

{% if block.settings.icon != blank %}

{{
block.settings.icon
| image_url: width:200
| image_tag:
loading:'lazy',
class:'brand-category__image'
}}

{% else %}

{{ 'image' | placeholder_svg_tag }}

{% endif %}

</div>

<div class="brand-category__title">

{{ block.settings.title }}

</div>

</a>

{% endfor %}

</div>

</div>

</div>

</section>

<style>

#brand-story-{{ section.id }}{

--heading-size:54px;
--body-size:16px;
--circle-size:120px;

}

#brand-story-{{ section.id }} .page-width{

max-width:1400px;
margin:auto;
padding:0 40px;

}

#brand-story-{{ section.id }} .brand-story{

display:flex;
flex-direction:column;
gap:70px;

}

#brand-story-{{ section.id }} .brand-story__content{
    max-width: 560px;
    margin: 0 auto;          /* Centers the content block */
    text-align: center;      /* Centers the text */
    display: flex;
    flex-direction: column;
    align-items: center;     /* Centers logo & button */
}

#brand-story-{{ section.id }} .brand-story__logo{
    margin: 0 0 25px;
}

#brand-story-{{ section.id }} .brand-story__logo img{

width:70px;
height:auto;
display:block;

}

#brand-story-{{ section.id }} .brand-story__eyebrow{

font-size:12px;
letter-spacing:.25em;
text-transform:uppercase;
margin-bottom:18px;

}

#brand-story-{{ section.id }} .brand-story__heading{

font-size: 36.75px;
line-height:1.1;
margin:0 0 25px;
font-weight:500;

}

#brand-story-{{ section.id }} .brand-story__description{

font-size:var(--body-size);
line-height:1.8;
margin-bottom:35px;

}

#brand-story-{{ section.id }} .brand-story__button{

display:inline-flex;
align-items:center;
justify-content:center;

padding:16px 34px;

background:#000;
color:#fff;

text-decoration:none;

letter-spacing:.08em;
text-transform:uppercase;

transition:.3s;

}

#brand-story-{{ section.id }} .brand-story__button:hover{

background:#333;

}

/*==========================
CATEGORY GRID
===========================*/

#brand-story-{{ section.id }} .brand-story__categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:32px;
    align-items:start;
}

#brand-story-{{ section.id }} .brand-category{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
    text-decoration:none;
    color:inherit;
    transition:.35s ease;
}

#brand-story-{{ section.id }} .brand-category__circle{
    width:var(--circle-size);
    height:var(--circle-size);
    border-radius:50%;
    background:{{ section.settings.circle_bg }};
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    transition:.35s ease;
}

#brand-story-{{ section.id }} .brand-category__image{
    width:65%;
    height:65%;
    object-fit:contain;
    transition:.35s ease;
}

#brand-story-{{ section.id }} .placeholder-svg{
    width:55%;
    height:55%;
}

#brand-story-{{ section.id }} .brand-category__title{
    margin-top:18px;
    font-size:13px;
    letter-spacing:.15em;
    text-transform:uppercase;
    text-align:center;
    color:{{ section.settings.text_color }};
    transition:.3s;
}

/*==========================
HOVER
===========================*/

#brand-story-{{ section.id }} .brand-category:hover .brand-category__circle{
    transform:translateY(-5px);
    box-shadow:0 12px 30px rgba(0,0,0,.08);
}

#brand-story-{{ section.id }} .brand-category:hover .brand-category__image{
    transform:scale(1.08);
}

#brand-story-{{ section.id }} .brand-category:hover .brand-category__title{
    opacity:.75;
}

/*==========================
TABLET
===========================*/

@media screen and (max-width:990px){

#brand-story-{{ section.id }} .page-width{
    padding:0 24px;
}

#brand-story-{{ section.id }}{
    --heading-size:42px;
    --circle-size:105px;
}

}

/*==========================
MOBILE
===========================*/

@media screen and (max-width:749px){


  #brand-story-{{ section.id }} .brand-story__content{
    margin: 0;
    text-align: left;
    align-items: flex-start;
}

#brand-story-{{ section.id }} .brand-story__logo{
    margin: 0 0 25px;
}

#brand-story-{{ section.id }}{
    --heading-size:32px;
    --body-size:15px;
    --circle-size:92px;
}

#brand-story-{{ section.id }} .page-width{
    padding:0 18px;
}

#brand-story-{{ section.id }} .brand-story{
    gap:45px;
}

#brand-story-{{ section.id }} .brand-story__description{
    margin-bottom:28px;
}

#brand-story-{{ section.id }} .brand-story__button{
    padding:14px 26px;
    font-size:13px;
}

#brand-story-{{ section.id }} .brand-story__categories{

    display:flex;
    overflow-x:auto;

    gap:18px;

    scroll-snap-type:x mandatory;

    -webkit-overflow-scrolling:touch;

    padding-bottom:10px;

}

#brand-story-{{ section.id }} .brand-story__categories::-webkit-scrollbar{
    display:none;
}

#brand-story-{{ section.id }} .brand-category{

    min-width:95px;

    scroll-snap-align:start;

    flex-shrink:0;

}

#brand-story-{{ section.id }} .brand-category__title{

    font-size:11px;

    margin-top:12px;

}

}

/*==========================
LARGE DESKTOP
===========================*/

@media screen and (min-width:1500px){

#brand-story-{{ section.id }}{

--heading-size:60px;
--circle-size:130px;

}

#brand-story-{{ section.id }} .page-width{

max-width:1500px;

}

}
</style>


{% schema %}
{
  "name": "Brand_stry_Categories",
  "tag": "section",
  "class": "brand-story-with-categories",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading",
      "default": "WELCOME TO IDCULT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to idcult"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Welcome to iDID is the first truly Cult Brand in the Indian one that immediately became a rage amongst its customers, who soon turned into loyalists.cult</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "KNOW MORE!"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "circle_bg",
      "label": "Category Circle Background",
      "default": "#f5f5f5"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Top Padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Bottom Padding"
    }
  ],

  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Category Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Sneakers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],

  "max_blocks": 12,

  "presets": [
    {
      "name": "Brand Story with Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Loafers"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sneakers"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Boots"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Formals"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sandals"
          }
        }
      ]
    }
  ]
}
{% endschema %}