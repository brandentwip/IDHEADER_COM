{% liquid

  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height

  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  case section.settings.text_position

    when 'top-left'
      assign text_position = 'top:40px;left:40px;'

    when 'top-right'
      assign text_position = 'top:40px;right:40px;text-align:right;'

    when 'bottom-right'
      assign text_position = 'bottom:40px;right:40px;text-align:right;'

    when 'center'
      assign text_position = 'top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;'

    else
      assign text_position = 'bottom:40px;left:40px;'

  endcase

%}

<section
  class="editorial-banner {% if section.settings.full_width %}full-width{% endif %}"
  id="editorial-banner-{{ section.id }}"
  style="
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
  "
>
  <div class="editorial-banner__wrapper">
    {% if section.settings.button_link != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="editorial-banner__link"
      >
    {% endif %}

    <div class="editorial-banner__image-wrapper">
      {% if section.settings.desktop_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width:749px)"
              srcset="{{ section.settings.mobile_image | image_url: width:900 }}"
            >
          {% endif %}

          {{
            section.settings.desktop_image
            | image_url: width: 2200
            | image_tag: loading: 'lazy', widths: '550,750,1100,1500,1800,2200', class: 'editorial-banner__image'
          }}
        </picture>
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      <div
        class="editorial-banner__overlay"
        style="
          background:{{ section.settings.overlay_color }};
          opacity:{{ overlay_opacity }};
        "
      ></div>

      <div class="editorial-banner__content">
        <div class="editorial-banner__text-group">
          {% if section.settings.label != blank %}
            <div
              class="editorial-banner__label"
              style="color:{{ section.settings.text_color }}"
            >
              {{ section.settings.label }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2
              class="editorial-banner__heading"
              style="color:{{ section.settings.text_color }}"
            >
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.text != blank %}
            <div
              class="editorial-banner__text"
              style="color:{{ section.settings.text_color }}"
            >
              {{ section.settings.text }}
            </div>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank -%}
          <span class="editorial-banner__button {{ section.settings.button_style }}">
            {{- section.settings.button_label -}}
          </span>
        {%- endif %}
      </div>
    </div>

    {% if section.settings.button_link != blank %}
      </a>
    {% endif %}
  </div>
</section>

<style>
  #editorial-banner-{{ section.id }}{

    --desktop-height:
    {% case desktop_height %}
      {% when 'small' %}500px
      {% when 'medium' %}650px
      {% when 'large' %}800px
      {% when 'fullscreen' %}100vh
      {% else %}auto
    {% endcase %};

    --mobile-height:
    {% case mobile_height %}
      {% when '350' %}350px
      {% when '450' %}450px
      {% when '550' %}550px
      {% else %}auto
    {% endcase %};

  }

  #editorial-banner-{{ section.id }}.full-width{
      width:100%;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__wrapper{
      max-width:1600px;
      margin:auto;
      position:relative;
  }

  #editorial-banner-{{ section.id }}.full-width .editorial-banner__wrapper{
      max-width:100%;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__link{
      display:block;
      color:inherit;
      text-decoration:none;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__image-wrapper{
      position:relative;
      overflow:hidden;
      height:var(--desktop-height);
  }

  #editorial-banner-{{ section.id }} .editorial-banner__image{
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
      transition:transform .7s ease;
  }



  #editorial-banner-{{ section.id }} .editorial-banner__overlay{
      position:absolute;
      inset:0;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__content{
       position:absolute;
      left:40px;
      right:40px;
      bottom:40px;

      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:40px;

      z-index:3;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__text-group{
      max-width:520px;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button{
      flex-shrink:0;
      white-space:nowrap;
  }

  #editorial-banner-{{ section.id }} .left{
      text-align:left;
  }

  #editorial-banner-{{ section.id }} .center{
      text-align:center;
  }

  #editorial-banner-{{ section.id }} .right{
      text-align:right;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__label{
      font-size:13px;
      letter-spacing:.25em;
      text-transform:uppercase;
      margin-bottom:12px;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__heading{
      margin:0;
      font-size:54px;
      line-height:1.05;
      font-weight:500;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__text{
      margin-top:18px;
      font-size:16px;
      line-height:1.7;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button{
      display:inline-block;
      margin-top:28px;
      padding:14px 30px;
      border:1px solid currentColor;
      transition:.3s;
      font-size:14px;
      letter-spacing:.08em;
      text-transform:uppercase;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button:hover{
      background:#000;
      color:#fff;
  }

  /* ---------- Button Styles ---------- */

  #editorial-banner-{{ section.id }} .editorial-banner__button.primary{
      background:#111;
      color:#fff;
      border-color:#111;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.primary:hover{
      background:#fff;
      color:#111;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.secondary{
      background:#fff;
      color:#111;
      border-color:#fff;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.secondary:hover{
      background:transparent;
      color:#fff;
      border-color:#fff;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.outline{
      background:transparent;
      color:;
      border:1px solid currentColor;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.outline:hover{
      background:currentColor;
      color:#fff;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button.text{
      padding:0;
      border:none;
      color:#fff;
      background:none;
      text-decoration:underline;
  }

  /* ---------- Adapt to image ---------- */

  {% if desktop_height == 'adapt' %}
  #editorial-banner-{{ section.id }} .editorial-banner__image-wrapper{
      height:auto;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__image{
      height:auto;
  }
  {% endif %}

  /* ---------- Mobile ---------- */

  @media screen and (max-width:749px){

  #editorial-banner-{{ section.id }} .editorial-banner__image-wrapper{
      height:var(--mobile-height);
  }

  {% if mobile_height == 'adapt' %}
  #editorial-banner-{{ section.id }} .editorial-banner__image-wrapper{
      height:auto;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__image{
      height:auto;
  }
  {% endif %}

  #editorial-banner-{{ section.id }} .editorial-banner__content{

      left:24px;
      right:24px;
      bottom:24px;

      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:20px;
  }
  #editorial-banner-{{ section.id }} .editorial-banner__heading{
      font-size:34px;
      line-height:1.1;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__label{
      font-size:11px;
      letter-spacing:.2em;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__text{
      font-size:14px;
      margin-top:12px;
      line-height:1.6;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__button{
      margin-top:18px;
      padding:12px 22px;
      font-size:12px;
  }

  {% case section.settings.text_position %}

  {% when 'bottom-left' %}
  #editorial-banner-{{ section.id }} .editorial-banner__content{
      left:24px !important;
      width: 90%;
      right:auto;
      bottom:24px !important;
      top:auto;
      transform:none;
  }

  {% when 'bottom-right' %}
  #editorial-banner-{{ section.id }} .editorial-banner__content{
      right:24px !important;
      left:auto;
      bottom:24px !important;
      top:auto;
      transform:none;
  }

  {% when 'top-left' %}
  #editorial-banner-{{ section.id }} .editorial-banner__content{
      left:24px !important;
      top:24px !important;
      bottom:auto;
      right:auto;
      transform:none;
  }

  {% when 'top-right' %}
  #editorial-banner-{{ section.id }} .editorial-banner__content{
      right:24px !important;
      top:24px !important;
      left:auto;
      bottom:auto;
      transform:none;
  }

  {% when 'center' %}
  #editorial-banner-{{ section.id }} .editorial-banner__content{
      left:50%;
      top:50%;
      transform:translate(-50%,-50%);
  }

  {% endcase %}

  }

  /* ---------- Large Desktop ---------- */

  @media screen and (min-width:1600px){

  #editorial-banner-{{ section.id }} .editorial-banner__heading{
      font-size:68px;
  }

  #editorial-banner-{{ section.id }} .editorial-banner__content{
      max-width:90%;
  }

  }

  /* ---------- Disable Hover on Touch ---------- */

  @media (hover:none){

  #editorial-banner-{{ section.id }} .editorial-banner__image-wrapper:hover .editorial-banner__image{
      transform:none;
  }

  }
</style>

{% schema %}
{
  "name": "Editorial Banner",
  "tag": "section",
  "class": "editorial-banner-section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" },

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Art of Leather"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Crafted for everyday luxury with timeless elegance.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "default": "large",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "fullscreen",
          "label": "Full Screen"
        },
        {
          "value": "adapt",
          "label": "Adapt to Image"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Height",
      "default": "450",
      "options": [
        {
          "value": "350",
          "label": "350px"
        },
        {
          "value": "450",
          "label": "450px"
        },
        {
          "value": "550",
          "label": "550px"
        },
        {
          "value": "adapt",
          "label": "Adapt to Image"
        }
      ]
    },

    {
      "type": "header",
      "content": "Text Position"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "default": "bottom-left",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "outline",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "text",
          "label": "Text Only"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "Editorial Banner" }]
}
{% endschema %}
