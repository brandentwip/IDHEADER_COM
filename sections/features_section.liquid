<section
  class="usp-icons columns-{{ section.settings.desktop_columns }} mobile-{{ section.settings.mobile_columns }} {% if section.settings.show_dividers %}show-dividers{% endif %}"
  style="
    --bg: {{ section.settings.bg }};
    --text: {{ section.settings.text }};
    --icon-size: {{ section.settings.icon_size }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>

<div class="page-width">

    {% if section.settings.heading != blank %}
        <div class="usp-header">
            <h2>{{ section.settings.heading }}</h2>
        </div>
    {% endif %}

    <div class="usp-grid">

        {% for block in section.blocks %}

            <div
                class="usp-item"
                {{ block.shopify_attributes }}
            >

                {% if block.settings.icon != blank %}

                    <div class="usp-icon">

                        {{
                            block.settings.icon
                            | image_url: width: 120
                            | image_tag:
                            loading: 'lazy'
                        }}

                    </div>

                {% endif %}

                {% if block.settings.heading != blank %}
                    <h3>
                        {{ block.settings.heading }}
                    </h3>
                {% endif %}

                {% if block.settings.text != blank %}
                    <p>
                        {{ block.settings.text }}
                    </p>
                {% endif %}

            </div>

        {% endfor %}

    </div>

</div>

</section>


<style>

/*=============================
  USP ICONS
==============================*/

.usp-icons{
    background:var(--bg);
    color:var(--text);
}

.usp-icons .page-width{
    max-width:1400px;
    margin:0 auto;
    padding:0 20px;
}

/*=============================
  HEADING
==============================*/

.usp-header{
    text-align:center;
    margin-bottom:60px;
}

.usp-header h2{
    margin:0;
    font-size:44px;
    line-height:1.15;
    font-weight:500;
    letter-spacing:-0.02em;
}

/*=============================
  GRID
==============================*/

.usp-grid{
    display:grid;
    gap:0;
}

/* Desktop Columns */

.columns-2 .usp-grid{
    grid-template-columns:repeat(2,1fr);
}

.columns-3 .usp-grid{
    grid-template-columns:repeat(3,1fr);
}

.columns-4 .usp-grid{
    grid-template-columns:repeat(4,1fr);
}

.columns-5 .usp-grid{
    grid-template-columns:repeat(5,1fr);
}

.columns-6 .usp-grid{
    grid-template-columns:repeat(6,1fr);
}

/*=============================
  ITEM
==============================*/

.usp-item{
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px;
    transition:.35s ease;
}

.usp-item:hover{
    transform:translateY(-4px);
}

/*=============================
  DIVIDER
==============================*/

.show-dividers .usp-item:not(:last-child)::after{
    content:"";
    position:absolute;
    right:0;
    top:25%;
    width:1px;
    height:50%;
    background:#E6E6E6;
}

/*=============================
  ICON
==============================*/

.usp-icon{
    width:var(--icon-size);
    height:var(--icon-size);
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:22px;
}

.usp-icon img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
}

/*=============================
  TEXT
==============================*/

.usp-item h3{
    margin:0;
    font-size:22px;
    line-height:1.3;
    font-weight:500;
}

.usp-item p{
    margin:10px 0 0;
    max-width:260px;
    font-size:15px;
    line-height:1.6;
    color:#6b6b6b;
}

/*=============================
  MOBILE
==============================*/

@media screen and (max-width:990px){

.usp-header{
    margin-bottom:35px;
}

.usp-header h2{
    font-size:30px;
}

/* Mobile Columns */

.mobile-1 .usp-grid{
    grid-template-columns:1fr;
}

.mobile-2 .usp-grid{
    grid-template-columns:repeat(3,1fr);
}

.usp-item{
    padding:24px 16px;
}

/* Remove desktop divider */

.show-dividers .usp-item::after{
    display:none;
}

/* Add divider only between columns */

.mobile-2.show-dividers .usp-item:nth-child(odd)::after{
    display:block;
    content:"";
    position:absolute;
    right:0;
    top:25%;
    width:1px;
    height:50%;
    background:#E6E6E6;
}

.usp-icon{
    width:calc(var(--icon-size) - 10px);
    height:calc(var(--icon-size) - 10px);
    margin-bottom:16px;
}

.usp-item h3{
    font-size:17px;
}

.usp-item p{
    font-size:13px;
    line-height:1.5;
    margin-top:8px;
}

}

</style>


{% schema %}
{
  "name": "USP Icons",
  "tag": "section",
  "class": "section-usp-icons",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why Shop With Us"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop Columns",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2 Columns"
        },
        {
          "value": "3",
          "label": "3 Columns"
        },
        {
          "value": "4",
          "label": "4 Columns"
        },
        {
          "value": "5",
          "label": "5 Columns"
        },
        {
          "value": "6",
          "label": "6 Columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Vertical Dividers",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Free shipping on all prepaid orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Icons",
      "blocks": [
        {
          "type": "usp"
        },
        {
          "type": "usp"
        },
        {
          "type": "usp"
        },
        {
          "type": "usp"
        }
      ]
    }
  ]
}
{% endschema %}