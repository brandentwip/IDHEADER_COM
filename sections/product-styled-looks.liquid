{% comment %}
  Section: Styled Looks (STATIC / CLIENT DEMO)
  Place in: sections/styled-looks-static.liquid
  No metafields. Each look is a block: upload image + edit title/items in the theme editor.
  Once the design is approved, switch to product-styled-looks.liquid (metafield version).
{% endcomment %}

<section
  class="sl-section"
  id="sl-{{ section.id }}"
  style="
    --sl-bg: {{ section.settings.bg_color }};
    --sl-text: {{ section.settings.text_color }};
    --sl-muted: {{ section.settings.muted_color }};
    --sl-radius: {{ section.settings.card_radius }}px;
    --sl-pt: {{ section.settings.padding_top }}px;
    --sl-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sl-inner">
    <header class="sl-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="sl-heading">
        <span class="sl-heading__line1">{{ section.settings.heading_line_1 }}</span>
        <span class="sl-heading__line2">{{ section.settings.heading_line_2 }}</span>
      </h2>

      {%- if section.settings.subtext_before != blank or section.settings.subtext_after != blank -%}
        <p class="sl-subtext">
          {{ section.settings.subtext_before }}
          <strong>{{ section.settings.label | downcase }}</strong>
          {{ section.settings.subtext_after }}
        </p>
      {%- endif -%}
    </header>

    <ul class="sl-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign look_items = block.settings.items | split: ',' -%}
        <li class="sl-card" {{ block.shopify_attributes }}>
          <div class="sl-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: '400, 600, 800',
                  sizes: '(min-width: 990px) 25vw, 70vw',
                  loading: 'lazy',
                  alt: block.settings.title,
                  class: 'sl-card__img'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'sl-card__img' }}
            {%- endif -%}
            <span class="sl-card__tag">
              {{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ section.settings.label }}
            </span>
          </div>

          <div class="sl-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="sl-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if look_items.size > 0 -%}
              <p class="sl-card__items">
                {%- for item in look_items -%}
                  {{ item | strip }}{% unless forloop.last %} &middot; {% endunless %}
                {%- endfor -%}
              </p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  #sl-{{ section.id }} {
    background: var(--sl-bg);
    color: var(--sl-text);
    padding: var(--sl-pt) 0 var(--sl-pb);
    border-radius: 28px;
    overflow: hidden;
  }
  #sl-{{ section.id }} .sl-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #sl-{{ section.id }} .sl-eyebrow {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--sl-text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #sl-{{ section.id }} .sl-eyebrow::before {
    content: '';
    width: 12px;
    height: 1px;
    background: currentColor;
  }
  #sl-{{ section.id }} .sl-heading {
    margin: 0;
    font-size: clamp(40px, 6vw, 56px);
    line-height: 0.95;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  #sl-{{ section.id }} .sl-heading span { display: block; }
  #sl-{{ section.id }} .sl-heading__line2 { color: var(--sl-muted); }
  #sl-{{ section.id }} .sl-subtext {
    margin: 18px 0 0;
    font-size: 14px;
    color: var(--sl-text);
    opacity: 0.85;
  }
  #sl-{{ section.id }} .sl-subtext strong { font-weight: 700; }

  #sl-{{ section.id }} .sl-grid {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  #sl-{{ section.id }} .sl-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--sl-radius);
    overflow: hidden;
    background: #1a1a1a;
  }
  #sl-{{ section.id }} .sl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  #sl-{{ section.id }} .sl-card:hover .sl-card__img { transform: scale(1.04); }
  #sl-{{ section.id }} .sl-card__tag {
    position: absolute;
    top: 14px;
    left: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  #sl-{{ section.id }} .sl-card__body { padding: 12px 4px 0; }
  #sl-{{ section.id }} .sl-card__title {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--sl-text);
  }
  #sl-{{ section.id }} .sl-card__items {
    margin: 4px 0 0;
    font-size: 11px;
    color: var(--sl-muted);
    line-height: 1.4;
  }

  @media (max-width: 989px) {
    #sl-{{ section.id }} .sl-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-right: -20px;
      padding-right: 20px;
    }
    #sl-{{ section.id }} .sl-grid::-webkit-scrollbar { display: none; }
    #sl-{{ section.id }} .sl-card {
      flex: 0 0 68%;
      max-width: 300px;
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "Styled Looks (Static)",
  "tag": "div",
  "class": "section-styled-looks",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WORN BY THE COMMUNITY" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "How he" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2 (muted)", "default": "wears it." },
    { "type": "text", "id": "label", "label": "Label", "default": "Men" },
    { "type": "text", "id": "subtext_before", "label": "Subtext before label", "default": "Looks" },
    { "type": "text", "id": "subtext_after", "label": "Subtext after label", "default": "are styling this season." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b6b" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Bandra Brunch" },
        { "type": "text", "id": "items", "label": "Items (comma separated)", "default": "Wide-leg denim, Cotton tee, Canvas tote" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "look", "settings": { "title": "The Bandra Brunch", "items": "Wide-leg denim, Cotton tee, Canvas tote" } },
      { "type": "look", "settings": { "title": "The Bookstore Fit", "items": "Linen shorts, Open shirt, Ribbed socks" } },
      { "type": "look", "settings": { "title": "The Weekend Casual", "items": "Relaxed cargos, Oversized tee, Flannel overshirt" } },
      { "type": "look", "settings": { "title": "The Park Street Fit", "items": "Cropped trousers, Plain tee, Boxy jacket" } }
    ]
  }
}
{% endschema %}
