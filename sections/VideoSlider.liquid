{% schema %}
{
  "name": "Video Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Our Reels"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4, WebM, or external link)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Your caption here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider",
      "category": "Media"
    }
  ]
}
{% endschema %}

<section class="video-slider-section">
  {% if section.settings.heading != blank %}
    <h2 class="video-slider-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="swiper video-slider-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide video-slide">
          <div class="video-container">
            <video 
              src="{{ block.settings.video_url }}" 
              playsinline 
              autoplay 
              muted 
              loop
              class="video-reel"
            ></video>
            {% if block.settings.caption != blank %}
              <p class="video-caption">{{ block.settings.caption }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Nav arrows -->
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</section>

<style>
.video-slider-section {
  background: #fff;
  padding: 5px 20px 5px 20px;
  text-align: center;
}

.video-slider-heading {
  font-size: 1.8rem;
  margin-bottom: 20px;
  font-weight: 600;
}
swiper-wrapper{
    transform: translate3d(1.214px, 0px, 0px) !important;
}


.video-container {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  
}

.video-reel {
  width: 100%;
  height: 100%;
  object-fit: cover;
  aspect-ratio: 9 / 16; /* Reel-style vertical */
  border-radius: 12px;
}

.video-caption {
  position: absolute;
  bottom: 12px;
  left: 12px;
  color: #fff;
  font-size: 0.9rem;
  background: rgba(0,0,0,0.4);
  padding: 4px 8px;
  border-radius: 6px;
}

/* Swiper arrows minimal */
.video-slider-swiper .swiper-button-prev,
.video-slider-swiper .swiper-button-next {
  color: #000;
  transition: opacity 0.3s;
}
.video-slider-swiper .swiper-button-prev:hover,
.video-slider-swiper .swiper-button-next:hover {
  opacity: 0.6;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  new Swiper('.video-slider-swiper', {
    slidesPerView: 1.1,
    spaceBetween: 20,
    centeredSlides: false,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    breakpoints: {
      768: {
        slidesPerView: 2.5,
      },
      1024: {
        slidesPerView: 3.5,
      }
    }
  });
});
</script>
