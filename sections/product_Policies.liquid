<style>

    .product-info-accordion{
    max-width:100%;
    padding: 3%;
    margin:0px auto;
}

.product-info-title{
    font-size:40px;
    font-weight:700;
    margin-bottom:30px;
}

.product-accordion-item{
    border-top:1px solid #e5e5e5;
}

.product-accordion-item:last-child{
    border-bottom:1px solid #e5e5e5;
}

.product-accordion-header{
    width:100%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:22px 0;
    background:none;
    border:none;
    cursor:pointer;
    font-size:18px;
    font-weight:500;
}

.product-accordion-header .icon{
    font-size:28px;
    transition:.3s;
}

.product-accordion-item.active .icon{
    transform:rotate(45deg);
}

.product-accordion-content{
    display:none;
    padding:0 0 25px;
    line-height:1.8;
    color:#444;
}

.product-accordion-content ul{
    margin-top:15px;
    padding-left:18px;
}

.product-accordion-content p{
    margin-bottom:16px;
}

.idc-clearance-alert{
    background:#fff5f5;
    border-left:4px solid #d60000;
    padding:15px;
    margin-bottom:20px;
}

@media(max-width:767px){

.product-info-title{
    font-size:30px;
}

.product-accordion-header{
    font-size:16px;
}

}

</style>



<div class="product-info-accordion">

  <h2 class="product-info-title">More about the sneaker</h2>

  <!-- Features -->
  <div class="product-accordion-item">
    <button class="product-accordion-header">
      <span>Features and Care</span>
      <span class="icon">+</span>
    </button>

    <div class="product-accordion-content">

      {{ product.description }}

      <div class="delivery-options">
        <strong>Delivery Options</strong>

        <ul>
          <li>100% Original Products</li>
          <li>Free Shipping On All Orders</li>
          <li>Cash On Delivery Available</li>
          <li>7 Days Friendly Return Policy</li>
        </ul>
      </div>

    </div>
  </div>


  <!-- Shipping -->
  <div class="product-accordion-item">
    <button class="product-accordion-header">
      <span>Shipping, Returns and Exchanges</span>
      <span class="icon">+</span>
    </button>

    <div class="product-accordion-content">

      {% if product.collections contains collections['clearancesale'] %}
      <p class="idc-clearance-alert">
        <strong>Note:</strong> This item is part of our <strong>Clearance Sale</strong>.
        Therefore, it is <strong>not eligible for return or exchange</strong>.
        Please confirm your selection before completing your purchase.
        Please also note that Clearance Sale items are
        <strong>not eligible for any other schemes / promotions.</strong>
      </p>
      {% endif %}

      <p>
        Return and Exchange Policy offer you the option to return or exchange
        items purchased on <strong>IDCult.com</strong> within 7 days of receipt.
      </p>

      <p>
        Products must be returned with tags and original packaging intact,
        unused and undamaged.
      </p>

      <p>
        Gifts or combo items must be returned in their entirety.
      </p>

      <p>
        For returns or exchanges, contact
        <a href="mailto:care@idcult.com">care@idcult.com</a><br>
        Phone:
        <a href="tel:+919910433300">+91 9910433300</a>
      </p>

    </div>
  </div>


  <!-- Origin -->
  <div class="product-accordion-item">
    <button class="product-accordion-header">
      <span>Origin and Contact</span>
      <span class="icon">+</span>
    </button>

    <div class="product-accordion-content">

      <p><strong>Country of Origin:</strong> INDIA</p>

      <p>
        <strong>Manufacturer / Packer / Importer</strong><br>
        M&B FOOTWEAR PRIVATE LIMITED,<br>
        C-33, Sector 58,<br>
        Noida, Gautam Buddha Nagar,<br>
        Uttar Pradesh - 201301
      </p>

      <p>
        <strong>Marketed By</strong><br>
        M&B FOOTWEAR PRIVATE LIMITED
      </p>

      <p>
        <strong>Customer Care</strong><br>

        Phone:
        <a href="tel:+919910433300">+91 9910433300</a><br>

        Email:
        <a href="mailto:care@idcult.com">care@idcult.com</a>
      </p>

    </div>
  </div>

</div>


<script>

    document.querySelectorAll('.product-accordion-header').forEach(button=>{

    button.addEventListener('click',()=>{

        const item=button.parentElement;

        item.classList.toggle('active');

        const content=item.querySelector('.product-accordion-content');

        if(content.style.display==="block"){
            content.style.display="none";
        }else{
            content.style.display="block";
        }

    });

});


</script>