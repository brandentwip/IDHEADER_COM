{% capture sb_include_manual_seo_log_ids_custom %}{% include "Secomapp-manual-seo-log-ids-custom" %}{% endcapture %}{% unless sb_include_manual_seo_log_ids_custom contains "Liquid error" %}{% include "Secomapp-manual-seo-log-ids-custom" %}{% endunless %}
{%- if template contains "404" -%}
{%- elsif template contains "index" -%}
{% capture secomapp_index_s %}Grab the Latest Men's Footwear Styles From Id Being Cult. Stay on Top of the Latest Trends with a wide range of Men's Casual, Formal and Athleisure Shoes From Id Being Cult.{% endcapture %}
<meta name="description" content="{{secomapp_index_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">

{%- elsif template contains "product" -%}

{% capture secomapp_product_s %}
 {%-if sb_res_check_custom_ids -%}
    {{ product.metafields.seo_booster.sb_description }}
    {%-else-%}
    {%comment%}bulk_edit_seo_product_des{%endcomment%}Shop  {{ product.title  | strip}} - {{ product.type  | strip}} at  {{ product.price  | money_without_currency | strip}}  on {{ shop.name  | strip }}.  {{ product.description | strip_html  | strip}}{%comment%}end:bulk_edit_seo_product_des{%endcomment%}
    {%- endif -%}
 {% endcapture %}

{% case secomapp_product_s %}
  {% when ' ' %}
   <meta name="description" content="{{page_description}}">
  {% when '' %}
    <meta name="description" content="{{page_description}}">
  {% when false %}
    <meta name="description" content="{{page_description}}">
  {% else %}
   <meta name="description" content="{{secomapp_product_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">
{% endcase %}

{%- elsif template contains "collection" -%}

{% capture secomapp_collection_s %}
 {%-if sb_res_check_custom_ids -%}
     {{ collection.metafields.seo_booster.sb_description }}
     {%-else-%}
     {%comment%}bulk_edit_seo_collection_des{%endcomment%}Shop  {{ collection.title  | strip}} on  {{ shop.name  | strip }}.  {{ collection.description | strip_html  | strip}}{%comment%}end:bulk_edit_seo_collection_des{%endcomment%}
     {%- endif -%}
 {% endcapture %}
{% case secomapp_collection_s %}
  {% when ' ' %}
   <meta name="description" content="{{page_description}}">
  {% when '' %}
    <meta name="description" content="{{page_description}}">
  {% when false %}
    <meta name="description" content="{{page_description}}">
  {% else %}
  <meta name="description" content="{{secomapp_collection_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">
{% endcase %}

{%- elsif template contains "blog" -%}

{% capture secomapp_blog_s %}Read more about {{ blog.articles | map: 'title' | join: ', '  | strip }} on iD Shoes{% endcapture %}
<meta name="description" content="{{ secomapp_blog_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">

{%- elsif template contains "article" -%}

{% capture secomapp_article_s %}
                        {%-if sb_res_check_custom_ids -%}
                            {{ article.metafields.seo_booster.sb_description }}
                        {%-else-%}
                            {%comment%}bulk_edit_seo_article_description{%endcomment%}undefined {{ page_description }}{%comment%}end:bulk_edit_seo_article_description{%endcomment%}
                        {%- endif -%}
                        {% endcapture %}
<meta name="description" content="{{ secomapp_article_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">


{% else %}
{% capture secomapp_other_s %}{{ page_description | strip_html | strip}} {% endcapture %}
<meta name="description" content="{{ secomapp_other_s | strip_html | strip | strip_newlines | replace: '"', "'"}}">

{%- endif -%}
