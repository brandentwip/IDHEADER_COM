{% comment %}
  Product Story / Feature Section
  Uses the first 3 images from the current product
{% endcomment %}

<div class="product-story-section">
<h2 class="product-story-heading">IT'S ALL IN THE DETAILS</h2>
  <div class="product-story-grid">

    <!-- CARD 01 -->
    {% if product.images[0] %}
      <div class="product-story-card">

        <div class="product-story-image">
          {{
            product.images[0]
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900, 1100, 1400',
              sizes: '(min-width: 750px) 33vw, 100vw',
              alt: product.title
          }}
        </div>

        <div class="product-story-content">
          <div class="product-story-text">
            <h3>Made for Everyday</h3>

            <p>
              Designed to keep you comfortable and confident from your everyday routines to wherever the day takes you.
            </p>
          </div>
        </div>

      </div>
    {% endif %}


    <!-- CARD 02 -->
    {% if product.images[1] %}
      <div class="product-story-card">

        <div class="product-story-image">
          {{
            product.images[1]
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900, 1100, 1400',
              sizes: '(min-width: 750px) 33vw, 100vw',
              alt: product.title
          }}
        </div>

        <div class="product-story-content">
          <div class="product-story-text">
            <h3>Comfort That Lasts</h3>

            <p>
              Thoughtfully designed for a comfortable fit, giving your feet the support they need throughout the day.
            </p>
          </div>
        </div>

      </div>
    {% endif %}


    <!-- CARD 03 -->
    {% if product.images[2] %}
      <div class="product-story-card">

        <div class="product-story-image">
          {{
            product.images[2]
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900, 1100, 1400',
              sizes: '(min-width: 750px) 33vw, 100vw',
              alt: product.title
          }}
        </div>

        <div class="product-story-content">
          <div class="product-story-text">
            <h3>Style Meets Craft</h3>

            <p>
              Clean detailing, timeless style and quality craftsmanship come together to create a pair made to stand out.
            </p>
          </div>
        </div>

      </div>
    {% endif %}

  </div>

</div>


<style>

/* =========================================
   PRODUCT STORY SECTION
   ========================================= */

.product-story-section {
  width: 100%;
  margin: 70px 0 30px;
}

.product-story-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
}


/* =========================================
   IMAGE
   ========================================= */

.product-story-image {
  width: 100%;
  aspect-ratio: 1 / 0.88;
  overflow: hidden;
  border-radius: 8px;
  background: #f5f5f5;
}

.product-story-image img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;

  /* Slight zoom */
  transform: scale(1.08);

  transition: transform 0.5s ease;
}


/* Optional subtle zoom on hover */

.product-story-card:hover .product-story-image img {
  transform: scale(1.12);
}


/* =========================================
   CONTENT
   ========================================= */

.product-story-content {
  margin-top: 14px;
}

.product-story-text h3 {
  margin: 0 0 7px;

  font-size: 17px;
  line-height: 1.2;
  padding-left:2%;
  font-weight: 800;
  text-transform: none;

  color: #111;

  letter-spacing: 0;
}

.product-story-text p {
  margin: 0;
padding-left:2%;
  font-size: 15px;
  line-height: 1.5;

  font-weight: 400;

  color: #777;
}


/* =========================================
   TABLET
   ========================================= */

@media screen and (max-width: 989px) {

  .product-story-section {
    margin-top: 55px;
  }

  .product-story-grid {
    gap: 10px;
  }

  .product-story-text h3 {
    font-size: 15px;
  }

  .product-story-text p {
    font-size: 14px;
  }

}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

  .product-story-section {
    margin: 45px 0 20px;
  }

  .product-story-grid {
    grid-template-columns: 1fr;
    gap: 38px;
  }

  .product-story-image {
    aspect-ratio: 1 / 0.72;
    border-radius: 6px;
  }

  .product-story-image img {
    transform: scale(1.06);
  }

  .product-story-card:hover .product-story-image img {
    transform: scale(1.06);
  }

  .product-story-content {
    margin-top: 12px;
  }

  .product-story-text h3 {
    font-size: 16px;
    margin-bottom: 6px;
    text-transform: none !important;
    padding-left:1% !important;
  }

  .product-story-text p {
    font-size: 14px;
    line-height: 1.45;
  }

}
/* =========================================
   HEADING
   ========================================= */

.product-story-heading {
  margin: -100px 0 28px;
  padding-left: 2% !important;
  font-size: 34px;
  line-height: 1.1;
  font-weight: 800;
  text-transform: uppercase;
  color: #111;
  text-align: left;
  letter-spacing: -0.02em;
}

@media screen and (max-width: 989px) {
  .product-story-heading {
    font-size: 28px;
    margin-bottom: 22px;
  }
}

@media screen and (max-width: 749px) {
  .product-story-heading {
    font-size: 22px;
    margin-bottom: 18px;
    line-height: 1.15;
  }
  .product-story-heading {
  margin: 2px 0 28px;
  
}
}

</style>