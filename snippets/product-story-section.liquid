{% comment %}
  Product Story / Feature Section

  Metafields expected:

  custom.story_image_1
  custom.story_heading_1
  custom.story_description_1

  custom.story_image_2
  custom.story_heading_2
  custom.story_description_2

  custom.story_image_3
  custom.story_heading_3
  custom.story_description_3

  Metafields are used first.
  If empty, the default fallback values are used.
{% endcomment %}


<div class="product-story-section">

  <h2 class="product-story-heading">
    IT'S ALL IN THE DETAILS
  </h2>

  <div class="product-story-grid">


    <!-- =====================================================
         CARD 01
    ====================================================== -->

    {% assign story_image_1 = product.metafields.custom.story_image_1.value %}
    {% assign story_heading_1 = product.metafields.custom.story_heading_1.value %}
    {% assign story_description_1 = product.metafields.custom.story_description_1 %}

    {% comment %}
      Fallback values
    {% endcomment %}

    {% if story_image_1 == blank %}
      {% assign story_image_1 = product.images[0] %}
    {% endif %}

    {% if story_heading_1 == blank %}
      {% assign story_heading_1 = 'Made for Everyday' %}
    {% endif %}

    {% if story_description_1 == blank %}
      {% assign story_description_1 = 'Designed to keep you comfortable and confident from your everyday routines to wherever the day takes you.' %}
    {% endif %}


    {% if story_image_1 != blank %}

      <div class="product-story-card">

        <div class="product-story-image">

          {% if story_image_1.preview_image != blank %}

            {{
              story_image_1.preview_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_1
            }}

          {% else %}

            {{
              story_image_1
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_1
            }}

          {% endif %}

        </div>


        <div class="product-story-content">

          <div class="product-story-text">

            <h3>
              {{ story_heading_1 }}
            </h3>

            <p>
              {{ story_description_1 }}
            </p>

          </div>

        </div>

      </div>

    {% endif %}



    <!-- =====================================================
         CARD 02
    ====================================================== -->

    {% assign story_image_2 = product.metafields.custom.story_image_2.value %}
    {% assign story_heading_2 = product.metafields.custom.story_heading_2.value %}
    {% assign story_description_2 = product.metafields.custom.story_description_2.value %}

    {% comment %}
      Fallback values
    {% endcomment %}

    {% if story_image_2 == blank %}
      {% assign story_image_2 = product.images[1] %}
    {% endif %}

    {% if story_heading_2 == blank %}
      {% assign story_heading_2 = 'Comfort That Lasts' %}
    {% endif %}

    {% if story_description_2 == blank %}
      {% assign story_description_2 = 'Thoughtfully designed for a comfortable fit, giving your feet the support they need throughout the day.' %}
    {% endif %}


    {% if story_image_2 != blank %}

      <div class="product-story-card">

        <div class="product-story-image">

          {% if story_image_2.preview_image != blank %}

            {{
              story_image_2.preview_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_2
            }}

          {% else %}

            {{
              story_image_2
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_2
            }}

          {% endif %}

        </div>


        <div class="product-story-content">

          <div class="product-story-text">

            <h3>
              {{ story_heading_2 }}
            </h3>

            <p>
              {{ story_description_2 }}
            </p>

          </div>

        </div>

      </div>

    {% endif %}



    <!-- =====================================================
         CARD 03
    ====================================================== -->

    {% assign story_image_3 = product.metafields.custom.story_image_3.value %}
    {% assign story_heading_3 = product.metafields.custom.story_heading_3.value %}
    {% assign story_description_3 = product.metafields.custom.story_description_3 %}

    {% comment %}
      Fallback values
    {% endcomment %}

    {% if story_image_3 == blank %}
      {% assign story_image_3 = product.images[2] %}
    {% endif %}

    {% if story_heading_3 == blank %}
      {% assign story_heading_3 = 'Style Meets Craft' %}
    {% endif %}

    {% if story_description_3 == blank %}
      {% assign story_description_3 = 'Clean detailing, timeless style and quality craftsmanship come together to create a pair made to stand out.' %}
    {% endif %}


    {% if story_image_3 != blank %}

      <div class="product-story-card">

        <div class="product-story-image">

          {% if story_image_3.preview_image != blank %}

            {{
              story_image_3.preview_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_3
            }}

          {% else %}

            {{
              story_image_3
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '500, 700, 900, 1100, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: story_heading_3
            }}

          {% endif %}

        </div>


        <div class="product-story-content">

          <div class="product-story-text">

            <h3>
              {{ story_heading_3 }}
            </h3>

            <p>
              {{ story_description_3 }}
            </p>

          </div>

        </div>

      </div>

    {% endif %}

  </div>

</div>



<style>

/* =========================================
   PRODUCT STORY SECTION
   ========================================= */

.product-story-section {
  width: 100%;
  margin: 70px 0 30px;
}

.product-story-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
}


/* =========================================
   IMAGE
   ========================================= */

.product-story-image {
  width: 100%;
  aspect-ratio: 1 / 0.88;
  overflow: hidden;
  border-radius: 8px;
  background: #f5f5f5;
}

.product-story-image img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: cover;

  transform: scale(1.08);

  transition: transform 0.5s ease;
}


/* =========================================
   HOVER
   ========================================= */

.product-story-card:hover .product-story-image img {
  transform: scale(1.12);
}


/* =========================================
   CONTENT
   ========================================= */

.product-story-content {
  margin-top: 14px;
}

.product-story-text h3 {
  margin: 0 0 7px;

  font-size: 17px;
  line-height: 1.2;

  padding-left: 2%;

  font-weight: 800;
  text-transform: none;

  color: #111;

  letter-spacing: 0;
}

.product-story-text p {
  margin: 0;

  padding-left: 2%;

  font-size: 15px;
  line-height: 1.5;

  font-weight: 400;

  color: #777;
}


/* =========================================
   HEADING
   ========================================= */

.product-story-heading {
  margin: -100px 0 28px;

  padding-left: 2% !important;

  font-size: 34px;
  line-height: 1.1;

  font-weight: 800;

  text-transform: uppercase;

  color: #111;

  text-align: left;

  letter-spacing: -0.02em;
}


/* =========================================
   TABLET
   ========================================= */

@media screen and (max-width: 989px) {

  .product-story-section {
    margin-top: 55px;
  }

  .product-story-grid {
    gap: 10px;
  }

  .product-story-text h3 {
    font-size: 15px;
  }

  .product-story-text p {
    font-size: 14px;
  }

  .product-story-heading {
    font-size: 28px;
    margin-bottom: 22px;
  }

}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

  .product-story-section {
    margin: 45px 0 20px;
  }

  .product-story-grid {
    grid-template-columns: 1fr;
    gap: 38px;
  }

  .product-story-image {
    aspect-ratio: 1 / 0.72;
    border-radius: 6px;
  }

  .product-story-image img {
    transform: scale(1.06);
  }

  .product-story-card:hover .product-story-image img {
    transform: scale(1.06);
  }

  .product-story-content {
    margin-top: 12px;
  }

  .product-story-text h3 {
    font-size: 16px;

    margin-bottom: 6px;

    text-transform: none !important;

    padding-left: 1% !important;
  }

  .product-story-text p {
    font-size: 14px;
    line-height: 1.45;
  }

  .product-story-heading {
    font-size: 22px;
    margin-bottom: 18px;
    line-height: 1.15;
  }

}

</style>  