{%- assign animation_row = 1 -%}
{%- assign drawer_position = 'right' -%}
{% if logo_alignment == 'center' %}
  {%- assign drawer_position = 'left' -%}
{% endif %}

{%- assign is_comet = section.settings.comet_enable -%}
{%- if is_comet == nil -%}
  {%- assign is_comet = true -%}
{%- endif -%}

<div id="NavDrawer" class="drawer drawer--{{ drawer_position }} {% if is_comet %}drawer--comet{% endif %}"
  style="--comet-header-bg: {{ section.settings.comet_header_bg | default: '#1d64f2' }}; --comet-header-text: {{ section.settings.comet_header_text | default: '#ffffff' }}; --comet-tab-bg: {{ section.settings.comet_tab_bg | default: '#ffffff' }}; --comet-tab-text: {{ section.settings.comet_tab_text | default: '#111111' }}; --comet-tab-active: {{ section.settings.comet_tab_active | default: '#1d64f2' }};">
  <div class="drawer__contents">
    
    {%- if is_comet -%}
      <!-- COMET-STYLE MOBILE DRAWER HEADER -->
      <div class="comet-drawer-header">
        <div class="comet-drawer-header__actions">
          <button type="button" class="comet-drawer-header__btn js-drawer-close" aria-label="{{ 'general.drawers.close_menu' | t }}">
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <a href="{{ routes.search_url }}" class="comet-drawer-header__btn" aria-label="Search">
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </a>
        </div>
        <div class="comet-drawer-header__logo">
          {%- assign logo_block = section.blocks | where: "type", "logo" | first -%}
          {%- if logo_block and logo_block.settings.logo != blank -%}
            <a href="{{ routes.root_url }}">
              <img src="{{ logo_block.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="comet-drawer-header__logo-text">{{ shop.name }}</a>
          {%- endif -%}
        </div>
      </div>

      <!-- TABS DETERMINATION LOGIC -->
      {%- liquid
        assign has_custom_tabs = false
        if section.settings.comet_tab1_title != blank or section.settings.comet_tab2_title != blank or section.settings.comet_tab3_title != blank or section.settings.comet_tab4_title != blank
          assign has_custom_tabs = true
        endif
      -%}

      <!-- TABS BAR -->
      <div class="comet-tabs-nav" role="tablist">
        {%- if has_custom_tabs -%}
          {%- if section.settings.comet_tab1_title != blank -%}
            <div class="comet-tab-item">
              <button type="button" class="comet-tab-button is-active" data-comet-tab="tab-1" role="tab" aria-selected="true">
                {{ section.settings.comet_tab1_title }}
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.comet_tab2_title != blank -%}
            <div class="comet-tab-item">
              <button type="button" class="comet-tab-button" data-comet-tab="tab-2" role="tab" aria-selected="false">
                {{ section.settings.comet_tab2_title }}
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.comet_tab3_title != blank -%}
            <div class="comet-tab-item">
              <button type="button" class="comet-tab-button" data-comet-tab="tab-3" role="tab" aria-selected="false">
                {{ section.settings.comet_tab3_title }}
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.comet_tab4_title != blank -%}
            <div class="comet-tab-item">
              <button type="button" class="comet-tab-button" data-comet-tab="tab-4" role="tab" aria-selected="false">
                {{ section.settings.comet_tab4_title }}
              </button>
            </div>
          {%- endif -%}
        {%- else -%}
          <!-- Auto tabs from Main Menu top-level links -->
          {%- for link in main_menu.links -%}
            <div class="comet-tab-item">
              <button type="button" class="comet-tab-button {% if forloop.first %}is-active{% endif %}" data-comet-tab="auto-tab-{{ forloop.index }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ link.title }}
              </button>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- TAB PANELS CONTENT -->
      <div class="drawer__scrollable">
        <div class="comet-tab-panels">
          {%- if has_custom_tabs -%}
            <!-- Custom Assigned Linklist Tabs -->
            {%- for i in (1..4) -%}
              {%- capture title_key -%}comet_tab{{ i }}_title{%- endcapture -%}
              {%- capture menu_key -%}comet_tab{{ i }}_menu{%- endcapture -%}
              {%- assign tab_title = section.settings[title_key] -%}
              {%- assign tab_menu_handle = section.settings[menu_key] -%}

              {%- if tab_title != blank -%}
                {%- assign tab_linklist = linklists[tab_menu_handle] -%}
                {%- if tab_linklist == blank and i == 1 -%}
                  {%- assign tab_linklist = main_menu -%}
                {%- endif -%}

                <div class="comet-tab-panel {% if i == 1 %}is-active{% endif %}" id="tab-{{ i }}" role="tabpanel">
                  <ul class="comet-menu-list">
                    {%- for link in tab_linklist.links -%}
                      {%- render 'comet-menu-item-render', link: link, section: section -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- endfor -%}

          {%- else -%}
            <!-- Auto-generated Tab Panels from Main Menu Children -->
            {%- for link in main_menu.links -%}
              <div class="comet-tab-panel {% if forloop.first %}is-active{% endif %}" id="auto-tab-{{ forloop.index }}" role="tabpanel">
                <ul class="comet-menu-list">
                  {%- if link.links != blank -%}
                    {%- for childlink in link.links -%}
                      {%- render 'comet-menu-item-render', link: childlink, section: section -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- render 'comet-menu-item-render', link: link, section: section -%}
                  {%- endif -%}
                </ul>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

    {%- else -%}
      <!-- ORIGINAL FALLBACK DRAWER HEADER -->
      <div class="drawer__fixed-header">
        <div class="drawer__header appear-animation appear-delay-{{ animation_row }}">
          <div class="h2 drawer__title"></div>
          <div class="drawer__close">
            <button type="button" class="drawer__close-button js-drawer-close">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/></svg>
              <span class="icon__fallback-text">{{ 'general.drawers.close_menu' | t }}</span>
            </button>
          </div>
        </div>
      </div>
      <div class="drawer__scrollable">
        <ul class="mobile-nav{% if settings.type_navigation_style == 'heading' %} mobile-nav--heading-style{% endif %}" role="navigation" aria-label="Primary">
          {%- for link in main_menu.links -%}
            <li class="mobile-nav__item">
              <a href="{{ link.url }}" class="mobile-nav__link mobile-nav__link--top-level">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- JS CONTROLLER FOR COMET DRAWER MENU -->
<script>
(function() {
  function initCometDrawer() {
    var drawer = document.getElementById('NavDrawer');
    if (!drawer) return;

    // Tab Switching
    var tabBtns = drawer.querySelectorAll('.comet-tab-button');
    var tabPanels = drawer.querySelectorAll('.comet-tab-panel');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = this.getAttribute('data-comet-tab');
        
        tabBtns.forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(function(p) {
          p.classList.remove('is-active');
        });

        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');
        var targetPanel = drawer.querySelector('#' + targetId);
        if (targetPanel) {
          targetPanel.classList.add('is-active');
        }
      });
    });

    // Sub-menu Accordion Toggles
    var toggles = drawer.querySelectorAll('.js-comet-toggle');
    toggles.forEach(function(toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var subList = this.closest('.comet-menu-item').querySelector('.comet-sub-list');
        if (subList) {
          var isOpen = subList.classList.contains('is-open');
          subList.classList.toggle('is-open', !isOpen);
          this.classList.toggle('is-open', !isOpen);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCometDrawer);
  } else {
    initCometDrawer();
  }
})();
</script>
