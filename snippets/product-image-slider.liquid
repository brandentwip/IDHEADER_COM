
<script type="text/javascript">
jQuery(document).ready(function(){
  
 	
    $( ".custom_product_thumb" ).each(function( index ) {

        if(index == 0){
            $(this).removeClass("defaultBorder");

            $(this).addClass("blackBorder");
        }
    });
    $(".close").click(function(){
        location.reload(); 
    });
    $(".custom_product_thumb").addClass("defaultBorder");
		
      	$( ".custom_product_thumb" ).click(function() {
        var image_path = $(this).attr("data-path");

        $(".custom_product_thumb").removeClass("hasBorder");        
        $(".custom_product_thumb").removeClass("blackBorder");      
      
        $(".custom_product_thumb").addClass("defaultBorder");

        $("img.pswp__img").attr("src", image_path);
        $(this).addClass("blackBorder");
        $(this).removeClass("defaultBorder");

    });
     
      
    $(".right").on("click",function() {       
        findNextIndex();
    });
  
  	$(".left").on("click",function() {       
//         findPreviousIndex();
    });
});
  	
$("body").bind("DOMNodeInserted", function() {
  
//    var img_length = $("#current_image .pswp__zoom-wrap").length;
  var current_image_count = $('#current_image .pswp__zoom-wrap').find('img').length;
  var next_image_count = $('#next_image .pswp__zoom-wrap').find('img').length;
  var previous_image_count = $('#previous_image .pswp__zoom-wrap').find('img').length;
 
  if(current_image_count == 2){
   $("#current_image .pswp__zoom-wrap").children().first().addClass('enable-item');
   $("#current_image .pswp__zoom-wrap").children().last().addClass('disabled-item');
  }
  if(next_image_count == 2){
   $("#next_image .pswp__zoom-wrap").children().first().addClass('enable-item');
   $("#next_image .pswp__zoom-wrap").children().last().addClass('disabled-item');
  }
  if(previous_image_count == 2){
   $("#previous_image .pswp__zoom-wrap").children().first().addClass('enable-item');
   $("#previous_image .pswp__zoom-wrap").children().last().addClass('disabled-item');
  }
});
  
 	
  $('img.pswp__img').on({ 'click touchend' : function(){ console.log(true); } });
  
  
function findNextIndex(){
  
  	
     
    $( ".custom_product_thumb" ).each(function( index ) {
      
      	var numItems = $('.custom_product_thumb').length;
      
        if($(this).hasClass("blackBorder")){

          var index = $(this).data("index"); 
          var next_index = parseInt(index)+1;
          	
          
          if(numItems - next_index >= 1 ){       
            			            
            $('.custom_product_thumb').removeClass('hasBorder');        
            $('.custom_product_thumb').removeClass('blackBorder');             
            $('.custom_product_thumb[data-index="'+next_index+'"]').removeClass('defaultBorder');            
            $('.custom_product_thumb[data-index="'+next_index+'"]').addClass('blackBorder');
            
          }else{
            $('.custom_product_thumb').removeClass('hasBorder');        
            $('.custom_product_thumb').removeClass('blackBorder');  
            $('.custom_product_thumb[data-index="0"]').removeClass('defaultBorder');            
            $('.custom_product_thumb[data-index="0"]').addClass('blackBorder');
			
          }
          var image_path = $('.custom_product_thumb[data-index="'+next_index+'"]').attr("data-path");
          $("img.pswp__img").attr("src", image_path);
            return false;
            
        }
      
    });    
    
}
  
function findPreviousIndex(){
     
    $( ".custom_product_thumb" ).each(function( index ) {
      
      	var numItems = $('.custom_product_thumb').length;
      	var last_div = numItems - 1;
      
        if($(this).hasClass("blackBorder")){

            var index = $(this).data("index"); 
            var previous_index = parseInt(index)-1;
//           	console.log(last_div);          	
		  console.log(numItems);
          console.log(previous_index);
          if(numItems - previous_index >= 0 ){            
            
            $('.custom_product_thumb').removeClass('hasBorder');        
            $('.custom_product_thumb').removeClass('blackBorder');             
            $('.custom_product_thumb[data-index="'+previous_index+'"]').removeClass('defaultBorder');            
            $('.custom_product_thumb[data-index="'+previous_index+'"]').addClass('blackBorder');
            
          }else{
            
            $('.custom_product_thumb').removeClass('hasBorder');        
            $('.custom_product_thumb').removeClass('blackBorder');  
            $('.custom_product_thumb[data-index="'+last_div+'"]').removeClass('defaultBorder');            
            $('.custom_product_thumb[data-index="'+last_div+'"]').addClass('blackBorder');            
			
          }
            return false;
            
        }
      
    });    
    
}
  
var alterClass = function() {
       
    var ww = document.body.clientWidth;

    if (ww < 600) {
      
      	$(".pswp__img:first-child").css("display", "block");
        
      	$(".pswp__img:last-child").css("display", "none");
        $('.product-slideshow').addClass('js-photoswipe__zoom');
    } else{
        $('.product-slideshow').removeClass('js-photoswipe__zoom');
    };
};
$(window).resize(function(){
    alterClass();
});
alterClass();
  
</script>
