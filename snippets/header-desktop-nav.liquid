{%- liquid
  unless limit
    assign limit = main_menu.links.size
  endunless
  unless offset
    assign offset = 0
  endunless
-%}

<style>
  /* Panel: flat, full-bleed, no floating-card look */
  .site-nav__dropdown.megamenu--shop {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    background-color: #ffffff !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    border-top: 1px solid #ececec;
  }
  .megamenu--shop .page-width {
    padding-top: 0;
    padding-bottom: 0;
  }
  .megamenu--shop__layout {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    padding: 24px 0;
  }

  /* Left link list — plain, title case, no box/uppercase treatment */
  .megamenu--shop__links {
    flex: 0 0 170px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .megamenu--shop__links li {
    margin: 0 0 12px;
  }
  .megamenu--shop__links li:last-child {
    margin-bottom: 0;
  }
  .megamenu--shop__links a {
    display: inline-block;
    font-size: 17px;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    line-height: 1.3;
  }
  .megamenu--shop__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Right side: real bordered grid, like a table */
  .megamenu--shop__products {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid #ececec;
    border-left: 1px solid #ececec;
  }
  .megamenu--shop__product {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 10px 14px;
    border-right: 1px solid #ececec;
    border-bottom: 1px solid #ececec;
    text-decoration: none;
    color: inherit;
  }
  .megamenu--shop__product:hover {
    background-color: #fafafa;
  }
  .megamenu--shop__product:hover .megamenu--shop__product-title {
    text-decoration: underline;
  }

  /* Fixed-size image box, hardened against theme-wide img resets (e.g. img{height:auto}) */
  .megamenu--shop__product-image-wrap {
    flex: 0 0 48px !important;
    width: 48px !important;
    height: 48px !important;
    box-sizing: border-box;
    background: #f4f4f4;
    overflow: hidden;
    display: block;
  }
  .megamenu--shop__product-image-wrap img.megamenu--shop__product-image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: contain !important;
  }

  .megamenu--shop__product-text {
    min-width: 0;
  }
  .megamenu--shop__product-title {
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
</style>

<ul
  class="site-nav site-navigation small--hide"
  {% unless disable_aria %}
    role="navigation" aria-label="Primary"
  {% endunless %}>
  {%- for link in main_menu.links limit: limit offset: offset -%}
    {%- liquid
      assign has_dropdown = false
      assign is_megamenu = false
      if link.links != blank
        assign has_dropdown = true
        if link.levels > 1
          assign is_megamenu = true
        endif
      endif

      # Check whether this top-level link points to a real collection.
      # If so, and it has child links, render it as a shop-style menu
      # (left link list + right product grid) instead of the standard megamenu.
      assign menu_collection = false
      if link.url contains '/collections/'
        assign lang_code_string = request.locale.iso_code | prepend: '/' | downcase
        assign top_collection_handle = link.url | remove: '/collections/' | remove: lang_code_string
        assign menu_collection = collections[top_collection_handle]
      endif

      assign is_shop_menu = false
      if menu_collection and menu_collection.products.size > 0 and has_dropdown
        assign is_shop_menu = true
      endif
    -%}

    <li
      class="site-nav__item site-nav__expanded-item{% if has_dropdown %} site-nav--has-dropdown{% endif %}{% if is_megamenu or is_shop_menu %} site-nav--is-megamenu{% endif %}"
      {% if has_dropdown %}aria-haspopup="true"{% endif %}>

      <a href="{{ link.url }}" class="site-nav__link site-nav__link--underline{% if has_dropdown %} site-nav__link--has-dropdown{% endif %}">
        {{ link.title }}
      </a>

      {%- if is_shop_menu -%}
        <div class="site-nav__dropdown megamenu megamenu--shop text-left">
          <div class="page-width">
            <div class="megamenu--shop__layout">

              <ul class="megamenu--shop__links">
                {%- for childlink in link.links -%}
                  <li>
                    <a href="{{ childlink.url }}" class="site-nav__dropdown-link">{{ childlink.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>

              <div class="megamenu--shop__products">
                {%- for product in menu_collection.products limit: 5 -%}
                  <a href="{{ product.url }}" class="megamenu--shop__product">
                    {%- if product.featured_image != blank -%}
                      <span class="megamenu--shop__product-image-wrap">
                        <img
                          class="megamenu--shop__product-image"
                          src="{{ product.featured_image | image_url: width: 100 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          loading="lazy"
                          width="48"
                          height="48">
                      </span>
                    {%- endif -%}
                    <span class="megamenu--shop__product-text">
                      <p class="megamenu--shop__product-title">{{ product.title }}</p>
                    </span>
                  </a>
                {%- endfor -%}
              </div>

            </div>
          </div>
        </div>

      {%- elsif is_megamenu -%}
        {%- assign previous_column_type = '' -%}
        {%- assign animation_column = 1 -%}

        <div class="site-nav__dropdown megamenu text-left">
          <div class="page-width">
            <div class="grid{% if dropdown_alignment == 'center' %} grid--center{% endif %}">
              <div class="grid__item medium-up--one-fifth appear-animation appear-delay-{{ animation_column }}">
                {%- assign animation_column = animation_column | plus: 1 -%}

                {%- for childlink in link.links -%}
                  {%- liquid
                    assign create_new_column = false

                    if childlink.levels > 0 and forloop.index != 1
                      assign create_new_column = true
                    endif

                    if childlink.levels == 0 and previous_column_type == 'full'
                      assign create_new_column = true
                    endif
                  -%}

                  {%- if create_new_column -%}
                    </div><div class="grid__item medium-up--one-fifth appear-animation appear-delay-{{ animation_column }}">
                    {%- assign animation_column = animation_column | plus: 1 -%}
                  {%- endif -%}

                  {%- assign subcollection_drop = false -%}
                  {%- if childlink.levels > 0 and childlink.url contains '/collections/' -%}
                    {%- liquid
                      assign lang_code_string = request.locale.iso_code | prepend: '/' | downcase
                      assign subcollection_handle = childlink.url | remove: '/collections/' | remove: lang_code_string
                      assign subcollection_drop = collections[subcollection_handle]
                    -%}
                    {%- if subcollection_drop.image != blank -%}
                      <a
                        href="{{ childlink.url }}"
                        class="megamenu__colection-image"
                        aria-label="{{collections[subcollection_handle].title}}"
                        style="background-image: url({{ collections[subcollection_handle].image | img_url: '400x' }})"></a>
                    {%- endif -%}
                  {%- endif -%}

                  <div class="h5">
                    <a href="{{ childlink.url }}" class="site-nav__dropdown-link site-nav__dropdown-link--top-level">{{ childlink.title }}</a>
                  </div>

                  {%- liquid
                    if childlink.levels > 0
                      assign previous_column_type = 'full'
                    else
                      assign previous_column_type = 'single'
                    endif
                  -%}

                  {%- for grandchildlink in childlink.links -%}
                    <div>
                      <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">
                        {{grandchildlink.title}}
                      </a>
                    </div>
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      {%- elsif has_dropdown -%}
        <ul class="site-nav__dropdown text-left">
          {%- for childlink in link.links -%}
            {%- liquid
              assign has_sub_dropdown = false
              if childlink.links != blank
                assign has_sub_dropdown = true
              endif
            -%}

            <li class="{% if has_sub_dropdown %} site-nav__deep-dropdown-trigger{% endif %}">
              <a href="{{ childlink.url }}" class="site-nav__dropdown-link site-nav__dropdown-link--second-level{% if has_sub_dropdown %} site-nav__dropdown-link--has-children{% endif %}">
                {{ childlink.title | escape }}
                {%- if has_sub_dropdown -%}
                  <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path d="M1.57 1.59l12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none" fill-rule="evenodd"/></svg>
                {%- endif -%}
              </a>
              {%- if has_sub_dropdown -%}
                <ul class="site-nav__deep-dropdown">
                  {%- for grandchildlink in childlink.links -%}
                    <li>
                      <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">{{ grandchildlink.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
