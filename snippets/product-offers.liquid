{% comment %}
  Product Offers
  Offer 1: Shop for Rs.3499 or above → Free Wallet
  Offer 2: Orders above ₹4,999 → Free Shoe Travel Bag
  Offer 3: Extra 5% off on first purchase → Code WELCOME5
{% endcomment %}

<div class="id-product-offers">

  <!-- OFFER 1 -->
  <div class="id-product-offer">

    <div class="id-product-offer-icon">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 3L14.1 8.1L19.5 8.6L15.4 12.2L16.6 17.5L12 14.7L7.4 17.5L8.6 12.2L4.5 8.6L9.9 8.1L12 3Z"
          fill="currentColor"
        />
        <path
          d="M12 7.2V11.5"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle
          cx="12"
          cy="14"
          r="0.8"
          fill="#fff"
        />
      </svg>
    </div>

    <div class="id-product-offer-content">
      <strong>Shop for Rs.3499 or above</strong> 
      <span>-</span>
      <span>Get a <strong>FREE Wallet*</strong></span>
    </div>

  </div>


  <!-- OFFER 2 -->
  <div class="id-product-offer">

    <div class="id-product-offer-icon">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 3L14.1 8.1L19.5 8.6L15.4 12.2L16.6 17.5L12 14.7L7.4 17.5L8.6 12.2L4.5 8.6L9.9 8.1L12 3Z"
          fill="currentColor"
        />
        <path
          d="M12 7.2V11.5"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle
          cx="12"
          cy="14"
          r="0.8"
          fill="#fff"
        />
      </svg>
    </div>

    <div class="id-product-offer-content">
      <strong>ORDER ABOVE ₹4,999</strong>
      <span>-</span>
      <span>Get a <strong>FREE Shoe Travel Bag*</strong></span>
    </div>

  </div>


  <!-- OFFER 3 -->
  <div class="id-product-offer">

    <div class="id-product-offer-icon">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M12 3L14.1 8.1L19.5 8.6L15.4 12.2L16.6 17.5L12 14.7L7.4 17.5L8.6 12.2L4.5 8.6L9.9 8.1L12 3Z"
          fill="currentColor"
        />
        <path
          d="M12 7.2V11.5"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle
          cx="12"
          cy="14"
          r="0.8"
          fill="#fff"
        />
      </svg>
    </div>

    <div class="id-product-offer-content">
      <strong>FIRST PURCHASE</strong>
      <span>-</span>
      <span>Get <strong>EXTRA 5% OFF</strong> using code <strong>WELCOME5</strong></span>
      <span>And additional 5% on <strong> prepaid </strong> orders </span>
    </div>

  </div>

</div>


<style>

/* =========================================================
   PRODUCT OFFERS
   ========================================================= */

.id-product-offers {
  width: 100%;
  margin: 22px 0 24px;
  padding: 14px 18px;
  background: #f7f7f7;
  border-radius: 7px;
  box-sizing: border-box;
}


/* =========================================================
   INDIVIDUAL OFFER
   ========================================================= */

.id-product-offer {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  box-sizing: border-box;
}


/* =========================================================
   SEPARATOR
   ========================================================= */

.id-product-offer + .id-product-offer {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #e7e7e7;
}


/* =========================================================
   OFFER ICON
   ========================================================= */

.id-product-offer-icon {
  width: 24px;
  height: 24px;
  min-width: 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #ffd747;
}

.id-product-offer-icon svg {
  width: 23px;
  height: 23px;
  display: block;
}


/* =========================================================
   OFFER TEXT
   ========================================================= */

.id-product-offer-content {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;

  font-size: 13px;
  line-height: 1.4;
  color: #111;
  font-weight: 400;
}

.id-product-offer-content strong {
  font-weight: 700;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .id-product-offers {
    margin: 18px 0 22px;
    padding: 13px 14px;
    border-radius: 6px;
  }

  .id-product-offer {
    gap: 9px;
  }

  .id-product-offer + .id-product-offer {
    margin-top: 10px;
    padding-top: 10px;
  }

  .id-product-offer-icon {
    width: 22px;
    height: 22px;
    min-width: 22px;
  }

  .id-product-offer-icon svg {
    width: 21px;
    height: 21px;
  }

  .id-product-offer-content {
    font-size: 11px;
    line-height: 1.45;
    gap: 5px;
  }

}


/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media screen and (max-width: 380px) {

  .id-product-offers {
    padding: 12px;
  }

  .id-product-offer-content {
    font-size: 10.5px;
  }

}

</style>